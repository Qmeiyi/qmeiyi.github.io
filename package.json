{
  "name": "qmeiyi.github.io",
  "private": true,
  "type": "module",
  "version": "0.9.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "强美伊的学术、开源与创业个人主页。",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run tests",
    "test:content": "node scripts/check-content-variants.mjs",
    "test:browser": "node scripts/check-content-variants.mjs --browser",
    "metrics:update": "node scripts/update-public-metrics.mjs",
    "verify": "pnpm test && pnpm astro check && pnpm build && node scripts/assert-built-site.mjs && pnpm test:content",
    "check:release": "node scripts/check-release.mjs"
  },
  "author": "Meiyi Qiang",
  "license": "MIT",
  "keywords": [
    "astro",
    "theme",
    "portfolio",
    "academic",
    "unocss"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Qmeiyi/qmeiyi.github.io.git"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.3.1",
    "astro-seo": "^1.2.0",
    "sharp": "0.35.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "1.63.0",
    "unocss": "^66.10.0",
    "vitest": "^5.0.0"
  }
}
