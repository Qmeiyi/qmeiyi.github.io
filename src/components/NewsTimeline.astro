---
import type { NewsCategory, NewsItem } from "../lib/news";

interface Props {
  items: NewsItem[];
  locale?: "zh" | "en";
  mode?: "scroll" | "full";
  ariaLabel?: string;
}

const { items, locale = "zh", mode = "scroll", ariaLabel = locale === "en" ? "News" : "个人经历" } = Astro.props;
const isEnglish = locale === "en";

const categoryMeta: Record<NewsCategory, { emoji: string; zh: string; en: string; tone: string }> = {
  paper: { emoji: "📚", zh: "发表", en: "Publication", tone: "violet" },
  ranking: { emoji: "🤗", zh: "榜单", en: "Ranking", tone: "amber" },
  education: { emoji: "🎓", zh: "升学", en: "Education", tone: "indigo" },
  entrepreneurship: { emoji: "🚀", zh: "创业", en: "Entrepreneurship", tone: "emerald" },
  award: { emoji: "🏆", zh: "获奖", en: "Award", tone: "amber" },
  business: { emoji: "🚩", zh: "商业活动", en: "Business", tone: "teal" },
};

const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const emphasize = (text: string, terms: string[]) => {
  const uniqueTerms = [...new Set(terms.filter(Boolean))].sort((a, b) => b.length - a.length);
  if (!uniqueTerms.length) return [{ text, strong: false }];

  const pattern = new RegExp(`(${uniqueTerms.map(escapeRegExp).join("|")})`, "g");
  const termSet = new Set(uniqueTerms);
  return text.split(pattern).filter(Boolean).map((part) => ({ text: part, strong: termSet.has(part) }));
};
---

<ol
  class:list={["news-list m-0 list-none p-0", mode === "scroll" && "news-list--scroll max-h-[27rem] overflow-y-auto"]}
  tabindex={mode === "scroll" ? "0" : undefined}
  aria-label={ariaLabel}
>
  {items.map((item) => {
    const meta = categoryMeta[item.category];
    return (
      <li class:list={["news-row grid min-w-0 items-start border-b border-paper-300/75 last:border-b-0 hover:bg-cyan-50/55 dark:border-ink-700/75 dark:hover:bg-accent-950/25", mode === "scroll" ? "news-row--scroll grid-cols-[5.6rem_2rem_minmax(0,1fr)] gap-2 px-3 py-2.5 sm:grid-cols-[6.25rem_2.1rem_minmax(0,1fr)] sm:items-center sm:gap-3 sm:px-4" : "news-row--full grid-cols-[5.8rem_2.25rem_minmax(0,1fr)] gap-2.5 px-3 py-3 sm:grid-cols-[7rem_2.4rem_minmax(0,1fr)_7rem] sm:items-center sm:gap-3 sm:px-5"]}>
        <time class="font-mono text-xs font-bold tabular-nums tracking-wide text-accent-800 dark:text-accent-200">{item.date}</time>
        <span class:list={["news-emoji relative z-[1] flex shrink-0 items-center justify-center rounded-lg border bg-white shadow-sm dark:bg-ink-900", `news-emoji--${meta.tone}`, mode === "scroll" ? "h-7 w-7 text-sm" : "h-8 w-8 text-base"]} role="img" aria-label={isEnglish ? meta.en : meta.zh}>{meta.emoji}</span>
        <p class:list={["min-w-0 font-medium text-ink-700 dark:text-paper-300", mode === "scroll" ? "text-sm leading-6" : "text-sm leading-6 sm:text-[0.95rem]"]}>
          {emphasize(item.text, item.strong).map((part) => part.strong
            ? <strong class="font-extrabold text-ink-950 dark:text-paper-50">{part.text}</strong>
            : part.text)}
          {item.links.map((link) => {
            const isExternal = /^https?:/i.test(link.href);
            return (
              <a href={link.href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined} class="ml-1 whitespace-nowrap font-bold text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-emerald-700 dark:text-accent-300 dark:decoration-accent-700 dark:hover:text-emerald-300">
                {link.label}<span class:list={["ml-0.5 inline-block align-[-0.08em] text-xs", isExternal ? "i-mdi:arrow-top-right" : "i-ph:arrow-right"]} aria-hidden="true"></span>
              </a>
            );
          })}
        </p>
        {mode === "full" && (
          <span class:list={["hidden justify-self-end rounded-full border px-2.5 py-1 text-[0.7rem] font-bold sm:inline-flex", `category-chip--${meta.tone}`]}>{isEnglish ? meta.en : meta.zh}</span>
        )}
      </li>
    );
  })}
</ol>

<style>
  .news-list--scroll {
    scrollbar-color: rgb(45 159 151 / 0.72) transparent;
    scrollbar-width: thin;
    overscroll-behavior: contain;
  }

  .news-list--scroll::-webkit-scrollbar { width: 7px; }
  .news-list--scroll::-webkit-scrollbar-track { background: transparent; }
  .news-list--scroll::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    border-radius: 999px;
    background: linear-gradient(180deg, rgb(6 182 212 / 0.72), rgb(16 185 129 / 0.72));
    background-clip: padding-box;
  }

  .news-row { position: relative; }
  .news-row--scroll::before,
  .news-row--full::before {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, rgb(6 182 212 / 0.25), rgb(16 185 129 / 0.25));
    content: "";
  }

  .news-row--scroll::before { left: 7.05rem; }
  .news-row--full::before { left: 9.95rem; }

  .news-emoji { border-color: rgb(103 197 196 / 0.36); }
  .news-emoji--amber { border-color: rgb(245 158 11 / 0.35); background-color: rgb(255 251 235 / 0.94); }
  .news-emoji--indigo { border-color: rgb(99 102 241 / 0.32); background-color: rgb(238 242 255 / 0.94); }
  .news-emoji--emerald { border-color: rgb(16 185 129 / 0.34); background-color: rgb(236 253 245 / 0.94); }
  .news-emoji--teal { border-color: rgb(20 184 166 / 0.34); background-color: rgb(240 253 250 / 0.94); }
  .news-emoji--violet { border-color: rgb(139 92 246 / 0.32); background-color: rgb(245 243 255 / 0.94); }

  .category-chip--cyan { border-color: rgb(103 232 249 / 0.7); background: rgb(236 254 255 / 0.9); color: rgb(21 94 117); }
  .category-chip--amber { border-color: rgb(253 230 138 / 0.8); background: rgb(255 251 235 / 0.9); color: rgb(146 64 14); }
  .category-chip--indigo { border-color: rgb(199 210 254 / 0.8); background: rgb(238 242 255 / 0.9); color: rgb(55 48 163); }
  .category-chip--emerald { border-color: rgb(167 243 208 / 0.8); background: rgb(236 253 245 / 0.9); color: rgb(6 95 70); }
  .category-chip--teal { border-color: rgb(153 246 228 / 0.8); background: rgb(240 253 250 / 0.9); color: rgb(17 94 89); }
  .category-chip--violet { border-color: rgb(221 214 254 / 0.8); background: rgb(245 243 255 / 0.9); color: rgb(91 33 182); }

  :global(.dark) .news-emoji { background-color: rgb(31 36 34 / 0.96); }
  :global(.dark) [class*="category-chip--"] { background: rgb(31 36 34 / 0.88); color: rgb(216 238 233); }

  @media (max-width: 639px) {
    .news-row--scroll::before { left: 6.7rem; }
    .news-row--full::before { left: 7.35rem; }
  }
</style>
