---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { parse } from "yaml";
import siteConfig from "../side.config";
import aboutRaw from "../data/about.yml?raw";
import newsRaw from "../data/news.yml?raw";

interface Props {
  locale?: "zh" | "en";
}

const { locale = "zh" } = Astro.props;
const isEnglish = locale === "en";

type NewsItem = {
  date: string | number;
  text: string;
  link?: { label: string; href: string };
};

type Experience = {
  role?: string;
  organization?: string;
  period?: string;
  bullets?: string[];
};

type Education = {
  degree?: string;
  institution?: string;
  year?: string;
};

type AboutSection = {
  title?: string;
  items?: Array<string | { title?: string; description?: string }>;
};

type AboutData = {
  experience?: Experience[];
  education?: Education[];
  sections?: AboutSection[];
};

const about = (parse(aboutRaw) ?? {}) as AboutData;
const chineseNews = (parse(newsRaw) ?? []) as NewsItem[];
const chineseExperience = about.experience ?? [];
const chineseEducation = about.education ?? [];
const chineseHonors =
  about.sections
    ?.find((section) => section.title === "荣誉奖励")
    ?.items?.filter((item): item is string => typeof item === "string") ?? [];

const copy = isEnglish
  ? {
      pageTitle: "Home",
      description: "Peking University master's student and co-founder of OriginHub, working on data-centric AI, training data, open-source systems, and real-world AI infrastructure.",
      affiliations: [
        { role: "M.Eng. Student", institution: "Peking University" },
        { role: "Co-founder", institution: "OriginHub", url: "https://originhub.tech/" },
      ],
      socialLabels: { "小红书": "RedNote", "邮件联系": "Email" } as Record<string, string>,
      paperCta: "Publications",
      status: "Research · Open Source · Entrepreneurship",
      newsLabel: "News",
      newsHeading: "Recent Updates",
      researchLabel: "Research Interests",
      researchHeading: "Research Interests",
      paperListCta: "View all publications",
      projectLabel: "Selected Work",
      projectHeading: "Projects & Entrepreneurship",
      projectDescription: "From research methods and open-source systems to real-world deployment, I build data-centric AI infrastructure across the full lifecycle.",
      active: "Active",
      completed: "Completed",
      experienceLabel: "Experience",
      experienceHeading: "Research & Industry Experience",
      educationLabel: "Education",
      educationHeading: "Education",
      honorsLabel: "Honors",
      honorsHeading: "Honors & Awards",
      connectLabel: "Let's Connect",
      connectHeading: "Collaboration",
      connectText: "I welcome conversations about data-centric AI, LLM training data, open-source collaboration, and industry applications.",
    }
  : {
      pageTitle: "首页",
      description: siteConfig.hero.subheadline,
      affiliations: siteConfig.affiliations,
      socialLabels: {} as Record<string, string>,
      paperCta: "研究成果与论文",
      status: siteConfig.hero.statusBadge,
      newsLabel: "News",
      newsHeading: "近期动态",
      researchLabel: "Research Interests",
      researchHeading: "研究方向",
      paperListCta: "查看完整论文列表",
      projectLabel: "Selected Work",
      projectHeading: "项目与创业实践",
      projectDescription: "从研究方法、开源系统到产业落地，持续推进以数据为中心的人工智能实践。",
      active: "进行中",
      completed: "已完成",
      experienceLabel: "Experience",
      experienceHeading: "科研与产业经历",
      educationLabel: "Education",
      educationHeading: "教育背景",
      honorsLabel: "Honors",
      honorsHeading: "荣誉奖励",
      connectLabel: "Let’s Connect",
      connectHeading: "交流与合作",
      connectText: "欢迎围绕数据中心人工智能、大模型训练数据、开源协作与产业应用交流。",
    };

const news: NewsItem[] = isEnglish
  ? [
      { date: 2026, text: "Advancing AI data infrastructure solutions and commercialization as co-founder of OriginHub.", link: { label: "Visit OriginHub", href: "https://originhub.tech/" } },
      { date: 2026, text: "Released the DataFlex technical report on data selection, mixture, and reweighting during LLM training.", link: { label: "Read the paper", href: "https://arxiv.org/abs/2603.26164" } },
      { date: 2025, text: "Released the DataFlow technical report on LLM-driven unified data preparation and workflow automation.", link: { label: "Read the paper", href: "https://arxiv.org/abs/2512.16676" } },
      { date: 2025, text: "Received the National Scholarship and the Beijing Outstanding Graduate honor." },
    ]
  : chineseNews;

const experience: Experience[] = isEnglish
  ? [
      { role: "Co-founder", organization: "OriginHub", period: "Present", bullets: ["Lead AI data infrastructure solutions and commercialization.", "Connect open-source capabilities in data preparation and dynamic training with real-world industry needs."] },
      { role: "Research Intern", organization: "PKU International Machine Learning Research Center", period: "Apr 2024 — Present", bullets: ["Research data selection, mathematical data synthesis and cleaning, and efficient LLM training under limited compute.", "Contribute research methods to open-source projects and multimodal data evaluation."] },
      { role: "Research Intern, Data Intelligence Platform", organization: "Ant Group", period: "Nov 2024 — Aug 2025", bullets: ["Designed construction, filtering, and synthesis pipelines for mathematical and multi-turn dialogue training data.", "Contributed to multimodal data evaluation, patent applications, and research papers."] },
      { role: "LLM Algorithm Intern", organization: "Zhipu AI", period: "Aug 2024 — Oct 2024", bullets: ["Worked on model training data, task-specific evaluation, and knowledge-base maintenance."] },
    ]
  : chineseExperience;

const education: Education[] = isEnglish
  ? [
      { degree: "M.Eng. in Electronic Information (in progress)", institution: "Peking University", year: "Sep 2025 — Jun 2028 (expected)" },
      { degree: "B.S. in Information and Computing Science", institution: "Beijing Institute of Technology", year: "Sep 2021 — Jun 2025" },
    ]
  : chineseEducation;

const honors = isEnglish
  ? ["National Scholarship", "Beijing Outstanding Graduate", "First-Class University Scholarship"]
  : chineseHonors;

const researchInterests = isEnglish
  ? ["Data-Centric AI", "LLM Training Data", "Data Selection", "Mathematical Reasoning & Data Quality"]
  : siteConfig.researchInterests;

const projectCopy: Record<string, { title: string; subtitle: string; summary: string; highlights: string[]; linkLabels: string[] }> = {
  originhub: {
    title: "OriginHub",
    subtitle: "AI data infrastructure solutions and commercialization",
    summary: "As co-founder, I connect data preparation, dynamic training, and enterprise AI capabilities with the needs of companies and research organizations.",
    highlights: ["Lead AI data infrastructure solutions and commercialization.", "Connect DataFlow and DataFlex capabilities with real-world applications."],
    linkLabels: ["Company website", "Public profile"],
  },
  dataflow: {
    title: "DataFlow",
    subtitle: "LLM-driven data preparation and workflows",
    summary: "As a core contributor, I work on production-ready operators and pipelines for mathematical and reasoning data construction, augmentation, and quality control.",
    highlights: ["Contribute to operator and pipeline engineering.", "Support chain-of-thought expansion, reasoning-error detection, and QA-level quality control.", "Maintain tests and user documentation."],
    linkLabels: ["GitHub repository"],
  },
  dataflex: {
    title: "DataFlex",
    subtitle: "Dynamic sample selection during training",
    summary: "I lead the algorithm implementation and engineering of Dynamic Select, integrating dynamic sample selection into LLaMA-Factory training workflows.",
    highlights: ["Implement the dynamic sample selection algorithm.", "Extend training configuration and integrate with LLaMA-Factory.", "Improve SFT effectiveness while reducing training cost."],
    linkLabels: ["GitHub repository"],
  },
};

const socialLinks = siteConfig.socialLinks.map((link) => ({
  ...link,
  label: copy.socialLabels[link.label] ?? link.label,
}));

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;
---

<Layout
  title={copy.pageTitle}
  description={copy.description}
  schemaType="ProfilePage"
  language={locale}
>
  <div class="space-y-14 pb-4 sm:space-y-20">
    <section class="border-b border-paper-300/90 pb-10 pt-3 dark:border-ink-700 sm:pb-14 sm:pt-6">
      <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-x-14">
        <div class="min-w-0">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-accent-700 dark:text-accent-300">
            Research · Open Source · Entrepreneurship
          </p>
          <h1 class="mt-3 max-w-4xl font-heading text-[clamp(2.7rem,6vw,4.7rem)] font-semibold leading-none tracking-[-0.04em] text-ink-950 dark:text-paper-50">
            {isEnglish ? "Meiyi Qiang" : siteConfig.author}
          </h1>
          <p class="mt-3 font-heading text-xl font-medium text-ink-700 dark:text-paper-200 sm:text-2xl">
            {isEnglish ? "强美伊" : "Meiyi Qiang"}
          </p>

          <div class="mt-5 space-y-1">
            {copy.affiliations.map((affiliation) => (
              <p class="text-base leading-7 text-ink-600 dark:text-paper-300">
                {affiliation.role}{isEnglish ? ", " : "，"}
                {affiliation.url ? (
                  <a
                    href={affiliation.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 dark:text-accent-300 dark:decoration-accent-700"
                  >
                    {affiliation.institution}
                  </a>
                ) : (
                  affiliation.institution
                )}
              </p>
            ))}
          </div>

          <p class="mt-6 max-w-[68ch] text-[1.08rem] leading-8 text-ink-700 dark:text-paper-300">
            {copy.description}
          </p>

          <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
            <a href={isEnglish ? "/en/researches" : "/researches"} class="action-link px-0">
              <span class="i-mdi:file-document-outline text-base" aria-hidden="true"></span>
              {copy.paperCta}
              <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
            </a>
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target={/^https?:/i.test(link.href) ? "_blank" : undefined}
                rel={/^https?:/i.test(link.href) ? "noopener noreferrer" : undefined}
                class="action-link px-0"
              >
                <span class={`${link.icon} text-base`} aria-hidden="true"></span>
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <aside class="flex items-start gap-4 lg:block">
          <div class="w-24 overflow-hidden rounded-xl border border-paper-300/90 bg-white/70 p-1.5 shadow-paper dark:border-ink-700 dark:bg-ink-900/70 lg:w-full lg:p-2">
            <Image
              src={profileImageUrl}
              alt={isEnglish ? "Portrait of Meiyi Qiang" : (siteConfig.hero.profileAlt || siteConfig.author)}
              width={siteConfig.hero.profileImageWidth || 188}
              height={siteConfig.hero.profileImageHeight || 252}
              layout="constrained"
              fit="cover"
              priority
              class="aspect-square h-auto w-full rounded-lg object-cover"
            />
          </div>
          <div class="mt-1 inline-flex items-center gap-1.5 rounded-md border border-accent-300/40 bg-accent-50/70 px-2.5 py-1 text-xs font-semibold text-accent-800 dark:border-accent-700/50 dark:bg-accent-950/40 dark:text-accent-200 lg:mt-4">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
            {copy.status}
          </div>
        </aside>
      </div>
    </section>

    <section class="content-section" aria-labelledby="news-heading">
      <div class="mb-5 border-b border-paper-300/90 pb-4 dark:border-ink-700">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.newsLabel}</p>
        <h2 id="news-heading" class="section-heading mt-1">{copy.newsHeading}</h2>
      </div>
      <ol class="divide-y divide-paper-300/80 border-y border-paper-300/80 dark:divide-ink-700/80 dark:border-ink-700/80">
        {news.map((item) => (
          <li class="grid gap-2 py-4 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-5">
            <time class="font-mono text-sm font-semibold tabular-nums text-accent-700 dark:text-accent-300">{item.date}</time>
            <p class="text-[0.98rem] leading-7 text-ink-700 dark:text-paper-300">
              {item.text}
              {item.link && (
                <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="ml-2 font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 dark:text-accent-300 dark:decoration-accent-700">
                  {item.link.label}
                </a>
              )}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="content-section" aria-labelledby="research-heading">
      <div class="mb-6 border-b border-paper-300/90 pb-4 dark:border-ink-700">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.researchLabel}</p>
        <h2 id="research-heading" class="section-heading mt-1">{copy.researchHeading}</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {researchInterests.map((interest, index) => (
          <article class="surface-card p-5 sm:p-6">
            <span class="font-mono text-xs font-semibold text-accent-700 dark:text-accent-300">0{index + 1}</span>
            <h3 class="entry-title mt-3 text-xl">{interest}</h3>
          </article>
        ))}
      </div>
      <a href={isEnglish ? "/en/researches" : "/researches"} class="action-link mt-5 px-0">
        {copy.paperListCta}
        <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
      </a>
    </section>

    <section class="content-section" aria-labelledby="projects-heading">
      <div class="mb-6 border-b border-paper-300/90 pb-4 dark:border-ink-700">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.projectLabel}</p>
        <h2 id="projects-heading" class="section-heading mt-1">{copy.projectHeading}</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-600 dark:text-paper-300">{copy.projectDescription}</p>
      </div>
      <div class="grid gap-5 lg:grid-cols-3">
        {projects.map((project, index) => {
          const translated = isEnglish ? projectCopy[project.id] : undefined;
          const subtitle = translated?.subtitle ?? project.data.subtitle;
          const summary = translated?.summary ?? project.data.summary;
          const highlights = translated?.highlights ?? project.data.highlights;
          return (
          <article class="surface-card flex h-full flex-col p-5 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-xs font-semibold text-accent-700 dark:text-accent-300">0{index + 1}</span>
              <span class={project.data.status === "active" ? "chip-status-active" : "chip-status-past"}>
                {project.data.status === "active" ? copy.active : copy.completed}
              </span>
            </div>
            <h3 class="entry-title mt-4 text-xl">{translated?.title ?? project.data.title}</h3>
            {subtitle && <p class="mt-1 text-xs font-semibold text-accent-700 dark:text-accent-300">{subtitle}</p>}
            <p class="mt-3 text-sm leading-7 text-ink-700 dark:text-paper-300">{summary}</p>
            {highlights.length > 0 && (
              <ul class="mt-4 space-y-2 text-sm leading-6 text-ink-600 dark:text-paper-300">
                {highlights.map((highlight) => (
                  <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span><span>{highlight}</span></li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex flex-wrap gap-3 pt-5">
              {project.data.links.map((link, linkIndex) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="action-link px-0 text-xs">
                  {translated?.linkLabels[linkIndex] ?? link.label}<span class="i-mdi:open-in-new text-sm" aria-hidden="true"></span>
                </a>
              ))}
            </div>
          </article>
          );
        })}
      </div>
    </section>

    <section class="content-section" aria-labelledby="experience-heading">
      <div class="mb-6 border-b border-paper-300/90 pb-4 dark:border-ink-700">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.experienceLabel}</p>
        <h2 id="experience-heading" class="section-heading mt-1">{copy.experienceHeading}</h2>
      </div>
      <div class="relative ml-2 border-l-2 border-paper-300/90 pl-6 dark:border-ink-700 sm:pl-8">
        {experience.map((item) => (
          <article class="relative pb-8 last:pb-0">
            <span class="absolute -left-[1.95rem] top-1.5 h-3 w-3 rounded-full border-2 border-accent-600 bg-paper-50 dark:bg-ink-950 sm:-left-[2.45rem]"></span>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <div>
                <h3 class="entry-title text-lg">{item.role}</h3>
                <p class="mt-1 font-semibold text-accent-700 dark:text-accent-300">{item.organization}</p>
              </div>
              <time class="shrink-0 font-mono text-xs text-ink-500 dark:text-paper-400">{item.period}</time>
            </div>
            {item.bullets && (
              <ul class="mt-3 space-y-1.5 text-sm leading-7 text-ink-700 dark:text-paper-300">
                {item.bullets.map((bullet) => <li>• {bullet}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
      <section class="content-section" aria-labelledby="education-heading">
        <div class="mb-5 border-b border-paper-300/90 pb-4 dark:border-ink-700">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.educationLabel}</p>
          <h2 id="education-heading" class="section-heading mt-1">{copy.educationHeading}</h2>
        </div>
        <div class="space-y-4">
          {education.map((item) => (
            <article class="surface-card p-5">
              <h3 class="entry-title text-lg">{item.institution}</h3>
              <p class="mt-1 text-sm text-ink-700 dark:text-paper-300">{item.degree}</p>
              <time class="mt-2 block font-mono text-xs text-ink-500 dark:text-paper-400">{item.year}</time>
            </article>
          ))}
        </div>
      </section>

      <section class="content-section" aria-labelledby="honors-heading">
        <div class="mb-5 border-b border-paper-300/90 pb-4 dark:border-ink-700">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.honorsLabel}</p>
          <h2 id="honors-heading" class="section-heading mt-1">{copy.honorsHeading}</h2>
        </div>
        <ul class="space-y-4">
          {honors.map((honor, index) => (
            <li class="surface-card flex items-center gap-4 p-5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-50 font-mono text-xs font-semibold text-accent-700 dark:bg-accent-950/50 dark:text-accent-300">0{index + 1}</span>
              <span class="font-heading text-lg font-semibold text-ink-900 dark:text-paper-100">{honor}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="rounded-2xl border border-accent-300/50 bg-accent-50/60 p-6 dark:border-accent-800/70 dark:bg-accent-950/30 sm:p-8" aria-labelledby="contact-heading">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.connectLabel}</p>
      <h2 id="contact-heading" class="mt-2 font-heading text-3xl font-semibold tracking-[-0.02em] text-ink-950 dark:text-paper-50">{copy.connectHeading}</h2>
      <p class="mt-3 max-w-2xl leading-7 text-ink-700 dark:text-paper-300">{copy.connectText}</p>
      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
        {socialLinks.map((link) => (
          <a href={link.href} target={/^https?:/i.test(link.href) ? "_blank" : undefined} rel={/^https?:/i.test(link.href) ? "noopener noreferrer" : undefined} class="action-link px-0">
            <span class={`${link.icon} text-base`} aria-hidden="true"></span>{link.label}
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
