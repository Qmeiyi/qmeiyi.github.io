---
import Layout from "../layouts/Layout.astro";
import NewsTimeline from "./NewsTimeline.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import siteConfig from "../side.config";
import { getAllPapers } from "../lib/papers";
import { getNews } from "../lib/news";
import publicMetrics from "../data/public-metrics.json";
import dataflowFeishuTutorial from "../assets/projects/tutorials/dataflow-feishu-tutorial.png";
import dataflowBilibiliTutorial from "../assets/projects/tutorials/dataflow-bilibili-tutorial.png";

interface Props {
  locale?: "zh" | "en";
}

const { locale = "zh" } = Astro.props;
const isEnglish = locale === "en";

const copy = isEnglish
  ? {
      pageTitle: "Home",
      description: "Peking University master's student working on data-centric AI and LLM training data, contributing to open-source systems and bringing AI data infrastructure into real-world applications.",
      affiliations: [
        { role: "M.Eng. Student", institution: "Peking University" },
        { role: "Co-founder", institution: "OriginHub", url: "https://originhub.tech/" },
      ],
      profileName: "Meiyi Qiang",
      profileEnglishName: "强美伊",
      profileTags: ["Entrepreneur", "Open Source Contributor", "AI Data Researcher"],
      aboutLabel: "About",
      aboutHeading: "About Me",
      wechatLabel: "WeChat",
      socialLabels: { "小红书": "RedNote", "邮件联系": "Email" } as Record<string, string>,
      paperCta: "Full publication list",
      experienceCta: "Experience",
      status: "Research · Open Source · Entrepreneurship",
      newsLabel: "News",
      newsHeading: "Latest Updates",
      newsScrollHint: "Scroll for more",
      researchLabel: "Research Interests",
      researchHeading: "Research Interests",
      researchDescription: "Four connected directions spanning training data, data-centric systems, dynamic model training, and intelligent data management.",
      relatedWork: "Representative work",
      paperListCta: "Full publication list",
      projectLabel: "Open Source",
      projectHeading: "Open Source Projects",
      totalStars: "Total GitHub Stars",
      projectDescription: "I contribute research methods and production engineering to open-source AI data infrastructure.",
      active: "Active",
      completed: "Completed",
      publicationsLabel: "Publications",
      publicationsHeading: "Research Outputs",
      publicationsDescription: "Selected work spanning data preparation, dynamic training, mathematical data quality, and data-centric AI.",
      publicationCta: "Full publication list",
      paperLinkLabel: "Paper",
    }
  : {
      pageTitle: "首页",
      description: siteConfig.hero.subheadline,
      affiliations: siteConfig.affiliations,
      profileName: "强美伊",
      profileEnglishName: "Meiyi Qiang",
      profileTags: ["创业者", "开源技术贡献者", "AI Data 研究者"],
      aboutLabel: "About",
      aboutHeading: "关于我",
      wechatLabel: "微信",
      socialLabels: {} as Record<string, string>,
      paperCta: "完整论文列表",
      experienceCta: "个人经历",
      status: siteConfig.hero.statusBadge,
      newsLabel: "News",
      newsHeading: "最新动态",
      newsScrollHint: "滚动查看更多",
      researchLabel: "Research Interests",
      researchHeading: "研究方向",
      researchDescription: "围绕训练数据、数据中心系统、动态模型训练与智能数据管理形成四个相互连接的研究方向。",
      relatedWork: "代表工作",
      paperListCta: "完整论文列表",
      projectLabel: "Open Source",
      projectHeading: "开源项目",
      totalStars: "GitHub 总 Stars",
      projectDescription: "将研究方法与工程能力沉淀到开源 AI 数据基础设施中。",
      active: "进行中",
      completed: "已完成",
      publicationsLabel: "Publications",
      publicationsHeading: "研究成果",
      publicationsDescription: "聚焦数据准备、动态训练、数学数据质量与数据中心人工智能的代表性研究。",
      publicationCta: "完整论文列表",
      paperLinkLabel: "论文",
    };

const aboutContent = isEnglish
  ? {
      paragraphs: [
        "I am Meiyi Qiang, a master's student at Peking University, a researcher, and an entrepreneur. I am honored to be advised by Prof. Wentao Zhang and to collaborate closely with Prof. Weinan E and Prof. Bin Cui. My research focuses on Data-Centric AI, particularly training data construction, data infrastructure, and dynamic data selection. I also contributed to the book Data for Large Models: Principles, Technologies, and Practice. Before joining Peking University, I earned my B.Sc. in Information and Computing Science from Beijing Institute of Technology, where I received the National Scholarship and was named a Beijing Outstanding Graduate.",
        "I have worked in foundation-model training and algorithm roles at ByteDance, Ant Group, and Zhipu AI, and have collaborated closely with teams at Tencent and Alibaba. I previously served as a co-founder of a data company with annual revenue exceeding RMB 10 million, where I led technical solution design and project delivery. The core open-source project DataFlow was showcased at WAIC 2025 and WAIC 2026. I have also been invited to give technical talks at China Unicom Software Research Institute, the 2026 Apsara Conference, and the 10th AIDD R&D Summit.",
      ],
      impactHeading: "Research Impact",
      competitionsHeading: "Competition Experience",
      competitions: [
        { title: "GOAI 2026 Global Open-Source AI Challenge", detail: "Agent Infra Track Champion (1 / 7,802) · Overall Runner-up" },
        { title: "Cesim Elite 2023 Global Business Simulation Competition", detail: "China Champion (1 / 1,700) · Global Runner-up" },
      ],
      pursuitHeading: "What I Want to Build",
      pursuit: [
        "I am an ENFJ who enjoys challenges and turning ideas into action. I hope to meet like-minded people who believe technology should solve real problems, and to build useful AI together that frees people from tedious, repetitive work. I welcome conversations about AI data, open-source systems, research collaboration, and entrepreneurship. I am also happy to recommend committed collaborators for graduate study at Peking University DCAI Lab and internships in industry.",
      ],
      peopleHeading: "People I Hope to Meet",
      people: [
        { title: "Foundation-model teams and vertical-industry companies", detail: "Organizations with training-data needs, private data or domain assets, and plans for data governance, model training, or AI transformation." },
        { title: "Researchers, engineers, and interns interested in AI Data", detail: "People exploring training data, data processing, data management, and Data-Centric AI." },
        { title: "AI founders and long-term collaborators", detail: "Builders identifying real needs, delivering technology, and exploring commercialization." },
      ],
      offerHeading: "What We Can Discuss",
      offers: [
        "Data flywheels, training-data construction, data governance, and quality evaluation",
        "Technical and project collaboration around DataFlow, DataFlex, and DataMind",
        "Research exchange, open-source collaboration, and Peking University DCAI Lab internship opportunities",
        "AI entrepreneurship, productization, industry delivery, and other forms of collaboration",
      ],
    }
  : {
      paragraphs: [
        "我是强美伊，北京大学硕士研究生，也是一名研究者和创业者。我很荣幸能师从张文涛教授，并与鄂维南教授和崔斌教授开展密切的科研合作。我的研究聚焦 Data-Centric AI，主要关注训练数据构建、数据基础设施与动态数据选择。我还参与编写《大模型数据·原理、技术与实践》一书。在此之前，我毕业于北京理工大学，获得信息与计算科学学士学位，并荣获国家奖学金和北京市优秀毕业生。",
        "我曾在字节、蚂蚁、智谱从事基础模型训练与算法相关实习，并与腾讯、阿里团队开展过良好合作。我也曾担任一家年营收超千万元的数据公司的联合创始人，负责技术方案设计与项目落地。核心开源项目 DataFlow 曾亮相 WAIC 2025 和 WAIC 2026。我也曾受邀在中国联通软件研究院、云栖大会 2026、第十届 AIDD 研发峰会等进行技术分享。",
      ],
      impactHeading: "研究影响力",
      competitionsHeading: "比赛经历",
      competitions: [
        { title: "GOAI 2026 世界人工智能开源大赛", detail: "Agent Infra 赛道冠军（1 / 7,802）· 全场亚军" },
        { title: "Cesim Elite 2023 全球商业模拟大赛", detail: "全国总冠军（1 / 1,700）· 全球亚军" },
      ],
      pursuitHeading: "我想做的事",
      pursuit: [
        "我是 ENFJ，喜欢挑战，也乐于把想法变成行动。我希望结识一群志同道合、相信技术能够解决真实问题的伙伴，一起探索真正有用的 AI，让人们从繁琐、重复的劳动中解放出来。欢迎与我交流 AI Data、开源技术、科研合作与创业实践；我也愿意为认真、有行动力的合作同学推荐北大 DCAI Lab 读研和工业界的实习机会。",
      ],
      peopleHeading: "我希望认识",
      people: [
        { title: "有训练数据需求的基础模型公司和垂直行业企业", detail: "包括拥有私有数据或行业资产，希望进行数据治理、模型训练和 AI 转型的企业。" },
        { title: "对 AI Data 感兴趣的研究人员、工程师和实习生", detail: "欢迎交流训练数据、数据处理、数据管理、Data-Centric AI 等研究方向。" },
        { title: "AI 领域的创业者和长期合作伙伴", detail: "希望认识正在寻找真实需求、推动技术落地和探索商业化的同行。" },
      ],
      offerHeading: "我可以提供和交流",
      offers: [
        "数据飞轮、训练数据构建、数据治理与质量评估",
        "DataFlow、DataFlex、DataMind 相关技术和项目合作",
        "研究交流、开源协作及北大 DCAI Lab 实习机会",
        "AI 创业、技术产品化、产业落地及其他形式的合作",
      ],
    };

const academicEntityLinks: Record<string, string> = {
  "Prof. Wentao Zhang": "https://scholar.google.com/citations?user=JE4VON0AAAAJ&hl=en",
  "Prof. Weinan E": "https://scholar.google.com/citations?user=i2mOt14AAAAJ&hl=en",
  "Prof. Bin Cui": "https://scholar.google.com/citations?user=IJAU8KoAAAAJ&hl=en",
  "张文涛教授": "https://scholar.google.com/citations?user=JE4VON0AAAAJ&hl=zh-CN",
  "鄂维南教授": "https://scholar.google.com/citations?user=i2mOt14AAAAJ&hl=zh-CN",
  "崔斌教授": "https://scholar.google.com/citations?user=IJAU8KoAAAAJ&hl=zh-CN",
  "北大 DCAI Lab": "https://zwt233.github.io/",
  "Peking University DCAI Lab": "https://zwt233.github.io/",
  "DCAI Lab": "https://zwt233.github.io/",
};

const academicEntityPattern = /(Peking University DCAI Lab|北大 DCAI Lab|Prof\. Wentao Zhang|Prof\. Weinan E|Prof\. Bin Cui|张文涛教授|鄂维南教授|崔斌教授|DCAI Lab)/g;
const splitAcademicEntities = (text: string) => text.split(academicEntityPattern).filter(Boolean);

const news = getNews(locale);

const sidebarEducation = isEnglish
  ? [
      { institution: "Peking University", degree: "M.Eng. in Electronic Information · Class of 2025" },
      { institution: "Beijing Institute of Technology", degree: "B.Sc. in Information and Computing Science · 2021–2025" },
    ]
  : [
      { institution: "北京大学", degree: "电子信息硕士·25级" },
      { institution: "北京理工大学", degree: "信息与计算科学本科·2021—2025" },
    ];

const researchDirections = isEnglish
  ? [
      {
        title: "Agent Training Data & Environment Design",
        subtitle: "Vertical agent tasks represented by Terminal-Bench and ALE",
        description: "Building executable, verifiable environments for trajectory collection, task synthesis, hard-case mining, and feedback design.",
        related: "WorkSurface-Bench · OmniaBench · DataFlex-RL",
        keywords: ["Environment Design", "Trajectory Data", "Verifiable Tasks", "Long-Horizon"],
      },
      {
        title: "Data-Centric AI & Data Infrastructure",
        subtitle: "Data preparation and governance centered on DataFlow",
        description: "Turning heterogeneous raw data into training-ready assets through data operators, programmable workflows, quality evaluation, and lineage.",
        related: "DataFlow · RayOrch · DataPrep-Bench",
        keywords: ["Data Preparation", "Data Operators", "Quality Evaluation", "Data Lineage"],
      },
      {
        title: "Dynamic Training Data & Model Co-evolution",
        subtitle: "Data selection and scheduling centered on DataFlex",
        description: "Adapting data selection, mixture, reweighting, and scheduling to model capability and learning progress across SFT and RLVR.",
        related: "DataFlex · DataFlex-RL · ReLIFT",
        keywords: ["Dynamic Selection", "Data Mixture", "Reweighting", "SFT / RLVR"],
      },
      {
        title: "Intelligent Data Management & Structured Knowledge",
        subtitle: "Data understanding and management centered on DataMind",
        description: "Connecting structured and unstructured knowledge through NL2SQL, knowledge graphs, and data agents for retrieval, reasoning, and action.",
        related: "DataMind · GraspLLM · K12-KGraph",
        keywords: ["Structured Data", "NL2SQL", "Knowledge Graph", "Data Agent"],
      },
    ]
  : [
      {
        title: "智能体训练数据与交互环境",
        subtitle: "面向 Terminal-Bench、ALE 等垂类智能体任务",
        description: "构建可执行、可验证的交互环境，研究轨迹采集、任务合成、难例挖掘与反馈信号设计。",
        related: "WorkSurface-Bench · OmniaBench · DataFlex-RL",
        keywords: ["环境构建", "轨迹数据", "可验证任务", "长程交互"],
      },
      {
        title: "数据中心人工智能与数据基础设施",
        subtitle: "以 DataFlow 为核心的数据准备与治理",
        description: "研究数据算子、可编程工作流、质量评估与血缘管理，将异构原始数据转化为训练就绪数据。",
        related: "DataFlow · RayOrch · DataPrep-Bench",
        keywords: ["数据准备", "数据算子", "质量评估", "数据血缘"],
      },
      {
        title: "动态训练数据与模型协同",
        subtitle: "以 DataFlex 为核心的数据选择与调度",
        description: "根据模型能力与学习进程，动态调整数据选择、配比、重加权与调度策略，覆盖 SFT 与 RLVR。",
        related: "DataFlex · DataFlex-RL · ReLIFT",
        keywords: ["动态选择", "数据配比", "样本重加权", "SFT / RLVR"],
      },
      {
        title: "智能数据管理与结构化知识",
        subtitle: "以 DataMind 为核心的数据理解与管理",
        description: "通过 NL2SQL、知识图谱与数据智能体连接结构化和非结构化知识，支持检索、推理与执行。",
        related: "DataMind · GraspLLM · K12-KGraph",
        keywords: ["结构化数据", "NL2SQL", "知识图谱", "Data Agent"],
      },
    ];

const featuredPaperIds = [
  "liang2027dataflow",
  "liang2026dataflex",
  "liang2026datapreparation",
  "liang2026mathdebugger",
];
const paperById = new Map(getAllPapers().map((paper) => [paper.id, paper]));
const featuredPapers = featuredPaperIds
  .map((id) => paperById.get(id))
  .filter((paper) => paper !== undefined);

function displayFeaturedAuthors(authors: string[]): string[] {
  if (authors.length <= 5) return authors;
  const visible = authors.slice(0, 3);
  if (!visible.includes("Meiyi Qiang")) visible.push("Meiyi Qiang");
  return visible;
}

function displayHighlight(highlight: string): string {
  if (isEnglish) return highlight;
  if (highlight.toLowerCase() === "core contributor") return "核心贡献者";
  if (highlight.toLowerCase() === "co-first author") return "共同一作";
  if (highlight.toLowerCase() === "survey") return "综述";
  return highlight;
}

const projectCopy: Record<string, { title: string; subtitle: string; summary: string; highlights: string[]; linkLabels: string[] }> = {
  originhub: {
    title: "OriginHub",
    subtitle: "AI data infrastructure solutions and commercialization",
    summary: "As co-founder, I connect data preparation, dynamic training, and enterprise AI capabilities with the needs of companies and research organizations.",
    highlights: ["Lead AI data infrastructure solutions and commercialization.", "Connect DataFlow and DataFlex capabilities with real-world applications."],
    linkLabels: ["Company website", "Public profile"],
  },
  dataflow: {
    title: "DataFlow",
    subtitle: "Unified data preparation infrastructure for LLMs",
    summary: "DataFlow turns noisy PDFs, text, web content, code, and multimodal inputs into model-ready data through composable operators and pipelines for refinement, generation, evaluation, and filtering.",
    highlights: ["Core contributor: advance the engineering of high-quality data generation and evaluation operators and reusable pipelines.", "Deployed in real-world projects with KuPas and the Suzhou Laboratory, among other partners."],
    linkLabels: ["GitHub repository", "Documentation", "Visual tutorials", "Video tutorials"],
  },
  dataflex: {
    title: "DataFlex",
    subtitle: "Data-centric dynamic training for LLMs",
    summary: "DataFlex provides a unified framework for data selection, mixture, and reweighting, enabling training data policies to adapt to model behavior and training progress.",
    highlights: ["Selection module lead: own the dynamic sample selection algorithm, training interfaces, and production integration.", "Integrated into the new official data processing module of LLaMA-Factory and deployed at China Unicom."],
    linkLabels: ["GitHub repository", "Documentation", "LLaMA-Factory"],
  },
  datamind: {
    title: "DataMind",
    subtitle: "All-in-one intelligent data assistant",
    summary: "An intelligent assistant built around LlamaIndex that brings RAG, GraphRAG, NL2SQL, Skills, Memory, and multimodal data access into one open-source system.",
    highlights: ["Project lead: drive product direction, technical roadmap, team collaboration, and delivery.", "Jointly developed with the Beijing Tongming Lake Information City Development Center."],
    linkLabels: ["GitHub repository", "Documentation"],
  },
};

const socialLinks = siteConfig.socialLinks.map((link) => ({
  ...link,
  label:
    link.label === "小红书"
      ? isEnglish ? "RedNote" : "小红书"
      : link.label === "邮件联系"
        ? "qiangmeiyi@gmail.com"
        : copy.socialLabels[link.label] ?? link.label,
  meta:
    link.label === "Google Scholar"
      ? isEnglish ? `${publicMetrics.scholar.citations.toLocaleString("en-US")} citations · h-index ${publicMetrics.scholar.hIndex}` : `引用 ${publicMetrics.scholar.citations.toLocaleString("zh-CN")} · h 指数 ${publicMetrics.scholar.hIndex}`
      : link.label === "小红书"
        ? isEnglish ? `${publicMetrics.xiaohongshu.followers.toLocaleString("en-US")} followers` : `${publicMetrics.xiaohongshu.followers.toLocaleString("zh-CN")} 粉丝`
        : undefined,
}));

const githubStars: Record<string, number> = publicMetrics.github;
const totalGithubStars = Object.values(githubStars)
  .filter((stars) => Number.isFinite(stars))
  .reduce((sum, stars) => sum + stars, 0);

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .filter((project) => project.id !== "originhub")
  .sort(
  (a, b) => a.data.order - b.data.order,
);

const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;
---

<Layout
  title={copy.pageTitle}
  description={copy.description}
  schemaType="ProfilePage"
  language={locale}
>
  <div class="profile-content space-y-14 pb-4 sm:space-y-20">
    <section id="about" class="home-section-card profile-hero-card scroll-mt-24 p-6 sm:p-8">
      <div>
        <div class="min-w-0">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-accent-700 dark:text-accent-300">{copy.aboutLabel}</p>
              <h1 class="section-heading mt-2 text-3xl sm:text-4xl">{copy.aboutHeading}</h1>
            </div>
            <div class="flex flex-wrap items-center gap-2 self-start sm:self-auto">
              <a
                href={isEnglish ? "/en/researches" : "/researches"}
                class="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-emerald-300/90 bg-emerald-50/75 px-4 py-2 text-sm font-semibold text-emerald-800 no-underline shadow-sm transition hover:border-emerald-400 hover:bg-emerald-100/80 hover:text-emerald-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 dark:border-emerald-800 dark:bg-emerald-950/35 dark:text-emerald-200 dark:hover:border-emerald-700 dark:hover:bg-emerald-950/55"
              >
                <span class="i-mdi:file-document-outline text-base" aria-hidden="true"></span>
                {copy.paperCta}
                <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
              </a>
              <a
                href={isEnglish ? "/en/experience" : "/experience"}
                class="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-cyan-300/90 bg-cyan-50/75 px-4 py-2 text-sm font-semibold text-cyan-800 no-underline shadow-sm transition hover:border-cyan-400 hover:bg-cyan-100/80 hover:text-cyan-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 dark:border-cyan-800 dark:bg-cyan-950/35 dark:text-cyan-200 dark:hover:border-cyan-700 dark:hover:bg-cyan-950/55"
              >
                <span class="i-mdi:timeline-clock-outline text-base" aria-hidden="true"></span>
                {copy.experienceCta}
                <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
              </a>
            </div>
          </div>

          <div class="mt-6 grid gap-4 lg:grid-cols-2">
            {aboutContent.paragraphs.map((paragraph, index) => (
              <section class:list={["about-story-card rounded-2xl border bg-white/90 p-5 shadow-sm dark:bg-ink-900/70", index === 0 ? "border-cyan-200/90 dark:border-cyan-900/70" : "border-emerald-200/90 dark:border-emerald-900/70"]}>
                <div class="mb-3 flex items-center gap-2">
                  <span class:list={[index === 0 ? "i-mdi:school-outline text-cyan-700 dark:text-cyan-300" : "i-mdi:rocket-launch-outline text-emerald-700 dark:text-emerald-300", "text-xl"]} aria-hidden="true"></span>
                  <h2 class="font-heading text-base font-semibold text-ink-950 dark:text-paper-50">
                    {index === 0 ? (isEnglish ? "Academic Profile" : "学术与研究") : (isEnglish ? "Industry & Entrepreneurship" : "产业与创业")}
                  </h2>
                </div>
                <p class:list={["text-sm leading-7 text-ink-700 dark:text-paper-300", !isEnglish && "paragraph-indent"]}>
                  {splitAcademicEntities(paragraph).map((part) => {
                    const href = academicEntityLinks[part];
                    return href ? (
                      <a href={href} target="_blank" rel="noopener noreferrer" class="academic-inline-link">{part}<span class="i-mdi:open-in-new text-[0.7rem]" aria-hidden="true"></span></a>
                    ) : part;
                  })}
                </p>
              </section>
            ))}
          </div>

          <div class="mt-5 space-y-3">
            <section class="about-wide-card grid gap-4 rounded-2xl border border-cyan-200/80 p-5 dark:border-cyan-900/70 sm:grid-cols-[13rem_1fr] sm:items-center" aria-labelledby="impact-heading">
              <div class="flex items-center gap-2">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-cyan-50 text-cyan-700 dark:bg-cyan-950/45 dark:text-cyan-300" aria-hidden="true"><span class="i-academicons:google-scholar text-xl"></span></span>
