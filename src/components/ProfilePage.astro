            <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.publicationsLabel}</p>
            <h2 id="publications-heading" class="section-heading mt-1">{copy.publicationsHeading}</h2>
          </div>
          <a
            href={isEnglish ? "/en/researches" : "/researches"}
            class="inline-flex min-h-9 shrink-0 items-center justify-center gap-1.5 self-start rounded-xl border border-cyan-300/90 bg-white/75 px-3 py-2 text-xs font-semibold text-cyan-800 no-underline shadow-sm transition hover:border-emerald-400 hover:bg-emerald-50/80 hover:text-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 dark:border-cyan-800 dark:bg-ink-900/65 dark:text-cyan-200 dark:hover:border-emerald-700 dark:hover:bg-emerald-950/35 dark:hover:text-emerald-200 sm:self-auto"
          >
            <span class="i-mdi:file-document-multiple-outline text-base" aria-hidden="true"></span>
            {copy.publicationCta}
            <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
          </a>
        </div>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-600 dark:text-paper-300">{copy.publicationsDescription}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {featuredPapers.map((paper) => (
          <article class="surface-card flex h-full flex-col overflow-hidden !p-0">
            <a href={paper.url} target="_blank" rel="noopener noreferrer" class="block border-b border-accent-200/70 bg-paper-50/80 p-3 dark:border-accent-800/60 dark:bg-ink-800/70">
              <img
                src={`/images/publications/${paper.id}.webp`}
                alt={isEnglish ? `Main figure from ${paper.title}` : `论文《${paper.title}》核心配图`}
                width="1200"
                height="650"
                loading="lazy"
                decoding="async"
                class="aspect-[16/9] h-auto w-full rounded-xl object-contain"
              />
            </a>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex flex-wrap items-center gap-2">
                {paper.venue && <span class="rounded-full border border-cyan-300/70 bg-cyan-50 px-2.5 py-1 text-xs font-bold text-cyan-800 dark:border-cyan-800 dark:bg-cyan-950/50 dark:text-cyan-200">{paper.venue}</span>}
                {paper.highlights.slice(0, 1).map((highlight) => <span class="rounded-full border border-emerald-300/70 bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-200">{displayHighlight(highlight)}</span>)}
              </div>
              <h3 class="entry-title mt-3 text-lg">{paper.title}</h3>
              <p class="mt-2 text-sm leading-6 text-ink-600 dark:text-paper-300">
                {displayFeaturedAuthors(paper.authors).map((author, authorIndex) => (
                  <>
                    {authorIndex > 0 && ", "}
                    <span class:list={[author === "Meiyi Qiang" && "font-bold text-ink-900 dark:text-paper-100"]}>{author}</span>
                  </>
                ))}
                {paper.authors.length > 5 ? ", et al." : ""}
              </p>
              {paper.url && (
                <a href={paper.url} target="_blank" rel="noopener noreferrer" class="action-link mt-auto pt-4 text-xs">
                  <span class="i-mdi:file-document-outline text-sm" aria-hidden="true"></span>{copy.paperLinkLabel}<span class="i-mdi:open-in-new text-sm" aria-hidden="true"></span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>
</Layout>

