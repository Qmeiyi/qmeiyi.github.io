---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { parse } from "yaml";
import siteConfig from "../side.config";
import newsRaw from "../data/news.yml?raw";
import { getAllPapers } from "../lib/papers";
import publicMetrics from "../data/public-metrics.json";
import dataflowFeishuTutorial from "../assets/projects/tutorials/dataflow-feishu-tutorial.png";
import dataflowBilibiliTutorial from "../assets/projects/tutorials/dataflow-bilibili-tutorial.png";

interface Props {
  locale?: "zh" | "en";
}

const { locale = "zh" } = Astro.props;
const isEnglish = locale === "en";

type NewsItem = {
  date: string | number;
  text: string;
  link?: { label: string; href: string };
};

const chineseNews = (parse(newsRaw) ?? []) as NewsItem[];

const copy = isEnglish
  ? {
      pageTitle: "Home",
      description: "Peking University master's student working on data-centric AI and LLM training data, contributing to open-source systems and bringing AI data infrastructure into real-world applications.",
      affiliations: [
        { role: "M.Eng. Student", institution: "Peking University" },
        { role: "Co-founder", institution: "OriginHub", url: "https://originhub.tech/" },
      ],
      profileName: "Meiyi Qiang",
      profileEnglishName: "强美伊",
      profileTags: ["Entrepreneur", "Open Source Contributor", "AI Data Researcher"],
      aboutLabel: "About",
      aboutHeading: "About",
      connectLabel: "Connect",
      connectHeading: "Open to Industry Collaboration",
      connectText: "I would be glad to connect with researchers, founders, and industry practitioners working on AI data, open-source systems, and real-world applications.",
      wechatLabel: "WeChat",
      emailLabel: "Email",
      socialLabels: { "小红书": "RedNote", "邮件联系": "Email" } as Record<string, string>,
      paperCta: "View complete publication list",
      status: "Research · Open Source · Entrepreneurship",
      newsLabel: "News",
      newsHeading: "Latest Updates",
      researchLabel: "Research Interests",
      researchHeading: "Research Interests",
      researchDescription: "Four connected directions spanning training data, data-centric systems, dynamic model training, and intelligent data management.",
      relatedWork: "Related work",
      keywordCloud: "Keyword Cloud",
      paperListCta: "View complete publication list",
      projectLabel: "Open Source",
      projectHeading: "Open Source Projects",
      projectDescription: "I contribute research methods and production engineering to open-source AI data infrastructure.",
      active: "Active",
      completed: "Completed",
      publicationsLabel: "Publications",
      publicationsHeading: "Research Outputs",
      publicationsDescription: "Selected work spanning data preparation, dynamic training, mathematical data quality, and data-centric AI.",
      publicationCta: "View complete publication list",
      paperLinkLabel: "Paper",
      honorsLabel: "Honors",
      honorsHeading: "Honors & Awards",
    }
  : {
      pageTitle: "首页",
      description: siteConfig.hero.subheadline,
      affiliations: siteConfig.affiliations,
      profileName: "强美伊",
      profileEnglishName: "Meiyi Qiang",
      profileTags: ["创业者", "开源技术贡献者", "AI Data 研究者"],
      aboutLabel: "About",
      aboutHeading: "关于",
      connectLabel: "Connect",
      connectHeading: "期待与行业朋友交流合作",
      connectText: "欢迎从事 AI 数据、开源技术与产业应用的朋友联系我，一起交流研究、产品与创业实践。",
      wechatLabel: "微信",
      emailLabel: "邮箱",
      socialLabels: {} as Record<string, string>,
      paperCta: "查看完整论文列表",
      status: siteConfig.hero.statusBadge,
      newsLabel: "News",
      newsHeading: "最新动态",
      researchLabel: "Research Interests",
      researchHeading: "研究方向",
      researchDescription: "围绕训练数据、数据中心系统、动态模型训练与智能数据管理形成四个相互连接的研究方向。",
      relatedWork: "相关研究",
      keywordCloud: "关键词词云",
      paperListCta: "查看完整论文列表",
      projectLabel: "Open Source",
      projectHeading: "开源项目",
      projectDescription: "将研究方法与工程能力沉淀到开源 AI 数据基础设施中。",
      active: "进行中",
      completed: "已完成",
      publicationsLabel: "Publications",
      publicationsHeading: "研究成果",
      publicationsDescription: "聚焦数据准备、动态训练、数学数据质量与数据中心人工智能的代表性研究。",
      publicationCta: "查看完整论文列表",
      paperLinkLabel: "论文",
      honorsLabel: "Honors",
      honorsHeading: "荣誉奖项",
    };

const news: NewsItem[] = isEnglish
  ? [
      { date: 2026, text: "Advancing AI data infrastructure solutions and commercialization as co-founder of OriginHub.", link: { label: "Visit OriginHub", href: "https://originhub.tech/" } },
      { date: 2026, text: "Released the DataFlex technical report on data selection, mixture, and reweighting during LLM training.", link: { label: "Read the paper", href: "https://arxiv.org/abs/2603.26164" } },
      { date: 2025, text: "Released the DataFlow technical report on LLM-driven unified data preparation and workflow automation.", link: { label: "Read the paper", href: "https://arxiv.org/abs/2512.16676" } },
      { date: 2025, text: "Received the National Scholarship and the Beijing Outstanding Graduate honor." },
    ]
  : chineseNews;

const sidebarEducation = isEnglish
  ? [
      { institution: "Peking University", degree: "M.Eng. in Electronic Information · Class of 2025" },
      { institution: "Beijing Institute of Technology", degree: "B.Sc. in Information and Computing Science · 2021–2025" },
    ]
  : [
      { institution: "北京大学", degree: "电子信息硕士·25级" },
      { institution: "北京理工大学", degree: "信息与计算科学本科·2021—2025" },
    ];

const researchDirections = isEnglish
  ? [
      {
        title: "Training Data",
        subtitle: "Vertical, executable, and verifiable data for agents",
        description: "Building high-quality training data for real tools and professional workflows, with task paradigms represented by ALE and Terminal-Bench: environment construction, trajectory collection, hard-case mining, synthesis, and verification, extending my work on mathematical-data quality and training-data preparation.",
        related: "MathDebugger · DataPrep-Bench · DataFlex-RL",
        keywords: ["ALE", "Terminal-Bench", "Agent Trajectories", "Verifiable Tasks", "Long-Horizon", "Vertical Data"],
      },
      {
        title: "Data-Centric AI & Data Processing",
        subtitle: "DataFlow and programmable preparation workflows",
        description: "Studying how refinement, generation, evaluation, filtering, lineage, and workflow automation turn noisy multimodal sources into model-ready data at scale.",
        related: "DataFlow · Data Preparation for LLMs · RayOrch",
        keywords: ["Data Preparation", "Operators", "Pipelines", "Data Quality", "Lineage", "Workflow Automation"],
      },
      {
        title: "Dynamic Training Data",
        subtitle: "Selection and scheduling with DataFlex",
        description: "Designing data selection, mixture, reweighting, and scheduling methods that adapt training data policies to model state and learning progress across SFT and reinforcement learning.",
        related: "DataFlex · IFT · Data-Centric LLM Training",
        keywords: ["Dynamic Selection", "Data Mixture", "Reweighting", "Scheduling", "SFT", "RLVR"],
      },
      {
        title: "Intelligent Data Management",
        subtitle: "Structured data and DataMind",
        description: "Connecting structured and unstructured knowledge through RAG, GraphRAG, NL2SQL, knowledge graphs, skills, and memory to build intelligent data systems that can retrieve, reason, and act.",
        related: "DataMind · GraspLLM · K12-KGraph",
        keywords: ["Structured Data", "NL2SQL", "Knowledge Graph", "RAG", "Memory", "Data Agents"],
      },
    ]
  : [
      {
        title: "Training Data",
        subtitle: "面向智能体的垂类、可执行、可验证训练数据",
        description: "面向真实工具与专业工作流构建高质量训练数据，围绕 ALE、Terminal-Bench 所代表的任务范式，研究环境构建、轨迹采集、难例挖掘、数据合成与结果验证，并延续数学数据质量和训练数据准备方面的研究积累。",
        related: "MathDebugger · DataPrep-Bench · DataFlex-RL",
        keywords: ["ALE", "Terminal-Bench", "智能体轨迹", "可验证任务", "长程任务", "垂类数据"],
      },
      {
        title: "数据中心人工智能与数据处理",
        subtitle: "以 DataFlow 为核心的可编程数据准备",
        description: "研究数据修正、生成、评估、过滤、血缘管理与工作流自动化，探索如何将噪声文本、网页、代码及多模态来源规模化转化为模型可用数据。",
        related: "DataFlow · Data Preparation for LLMs · RayOrch",
        keywords: ["数据准备", "算子", "Pipeline", "数据质量", "数据血缘", "工作流自动化"],
      },
      {
        title: "模型训练数据与动态调度",
        subtitle: "以 DataFlex 为核心的数据选择与训练协同",
        description: "研究随模型状态和训练进程变化的数据选择、混合、重加权与调度策略，覆盖监督微调和强化学习阶段，让训练数据策略与模型学习过程协同演化。",
        related: "DataFlex · IFT · Data-Centric LLM Training",
        keywords: ["动态选择", "数据混合", "样本重加权", "数据调度", "SFT", "RLVR"],
      },
      {
        title: "智能数据管理与结构化数据",
        subtitle: "以 DataMind 为核心的数据理解与管理",
        description: "通过 RAG、GraphRAG、NL2SQL、知识图谱、Skills 与 Memory 连接结构化和非结构化知识，构建能够检索、推理并执行的数据智能系统。",
        related: "DataMind · GraspLLM · K12-KGraph",
        keywords: ["结构化数据", "NL2SQL", "知识图谱", "RAG", "Memory", "数据智能体"],
      },
    ];

const researchCloud = isEnglish
  ? [
      { label: "Training Data", size: "text-2xl sm:text-3xl", tone: "text-cyan-800 dark:text-cyan-200" },
      { label: "Data-Centric AI", size: "text-xl sm:text-2xl", tone: "text-emerald-700 dark:text-emerald-300" },
      { label: "ALE", size: "text-lg sm:text-xl", tone: "text-blue-700 dark:text-blue-300" },
      { label: "Terminal-Bench", size: "text-xl sm:text-2xl", tone: "text-teal-700 dark:text-teal-300" },
      { label: "DataFlow", size: "text-2xl", tone: "text-cyan-700 dark:text-cyan-300" },
      { label: "Dynamic Selection", size: "text-lg", tone: "text-emerald-700 dark:text-emerald-300" },
      { label: "DataFlex", size: "text-xl", tone: "text-blue-700 dark:text-blue-300" },
      { label: "Agent Trajectories", size: "text-base", tone: "text-teal-700 dark:text-teal-300" },
      { label: "DataMind", size: "text-xl", tone: "text-cyan-800 dark:text-cyan-200" },
      { label: "Structured Data", size: "text-lg", tone: "text-emerald-800 dark:text-emerald-200" },
      { label: "RLVR", size: "text-base", tone: "text-blue-700 dark:text-blue-300" },
      { label: "Data Quality", size: "text-lg", tone: "text-teal-800 dark:text-teal-200" },
      { label: "Mathematical Data", size: "text-base", tone: "text-blue-700 dark:text-blue-300" },
      { label: "Benchmarking", size: "text-lg", tone: "text-emerald-700 dark:text-emerald-300" },
      { label: "Multimodal Data", size: "text-base", tone: "text-cyan-700 dark:text-cyan-300" },
      { label: "NL2SQL", size: "text-base", tone: "text-cyan-700 dark:text-cyan-300" },
      { label: "Verifiable Tasks", size: "text-lg", tone: "text-emerald-700 dark:text-emerald-300" },
    ]
  : [
      { label: "Training Data", size: "text-2xl sm:text-3xl", tone: "text-cyan-800 dark:text-cyan-200" },
      { label: "数据中心人工智能", size: "text-xl sm:text-2xl", tone: "text-emerald-700 dark:text-emerald-300" },
      { label: "ALE", size: "text-lg sm:text-xl", tone: "text-blue-700 dark:text-blue-300" },
      { label: "Terminal-Bench", size: "text-xl sm:text-2xl", tone: "text-teal-700 dark:text-teal-300" },
      { label: "DataFlow", size: "text-2xl", tone: "text-cyan-700 dark:text-cyan-300" },
      { label: "动态选择", size: "text-lg", tone: "text-emerald-700 dark:text-emerald-300" },
      { label: "DataFlex", size: "text-xl", tone: "text-blue-700 dark:text-blue-300" },
      { label: "智能体轨迹", size: "text-base", tone: "text-teal-700 dark:text-teal-300" },
      { label: "DataMind", size: "text-xl", tone: "text-cyan-800 dark:text-cyan-200" },
      { label: "结构化数据", size: "text-lg", tone: "text-emerald-800 dark:text-emerald-200" },
      { label: "RLVR", size: "text-base", tone: "text-blue-700 dark:text-blue-300" },
      { label: "数据质量", size: "text-lg", tone: "text-teal-800 dark:text-teal-200" },
      { label: "数学数据", size: "text-base", tone: "text-blue-700 dark:text-blue-300" },
      { label: "基准评测", size: "text-lg", tone: "text-emerald-700 dark:text-emerald-300" },
      { label: "多模态数据", size: "text-base", tone: "text-cyan-700 dark:text-cyan-300" },
      { label: "NL2SQL", size: "text-base", tone: "text-cyan-700 dark:text-cyan-300" },
      { label: "可验证任务", size: "text-lg", tone: "text-emerald-700 dark:text-emerald-300" },
    ];

const featuredPaperIds = [
  "liang2027dataflow",
  "liang2026dataflex",
  "liang2026datapreparation",
  "liang2026mathdebugger",
];
const paperById = new Map(getAllPapers().map((paper) => [paper.id, paper]));
const featuredPapers = featuredPaperIds
  .map((id) => paperById.get(id))
  .filter((paper) => paper !== undefined);

const honors = isEnglish
  ? ["National Scholarship", "Beijing Outstanding Graduate", "First-Class University Scholarship"]
  : ["国家奖学金", "北京市优秀毕业生", "校级优秀学生一等奖学金"];

function displayFeaturedAuthors(authors: string[]): string[] {
  if (authors.length <= 5) return authors;
  const visible = authors.slice(0, 3);
  if (!visible.includes("Meiyi Qiang")) visible.push("Meiyi Qiang");
  return visible;
}

function displayHighlight(highlight: string): string {
  if (isEnglish) return highlight;
  if (highlight.toLowerCase() === "core contributor") return "核心贡献者";
  if (highlight.toLowerCase() === "co-first author") return "共同一作";
  if (highlight.toLowerCase() === "survey") return "综述";
  return highlight;
}

const projectCopy: Record<string, { title: string; subtitle: string; summary: string; highlights: string[]; linkLabels: string[] }> = {
  originhub: {
    title: "OriginHub",
    subtitle: "AI data infrastructure solutions and commercialization",
    summary: "As co-founder, I connect data preparation, dynamic training, and enterprise AI capabilities with the needs of companies and research organizations.",
    highlights: ["Lead AI data infrastructure solutions and commercialization.", "Connect DataFlow and DataFlex capabilities with real-world applications."],
    linkLabels: ["Company website", "Public profile"],
  },
  dataflow: {
    title: "DataFlow",
    subtitle: "Unified data preparation infrastructure for LLMs",
    summary: "DataFlow turns noisy PDFs, text, web content, code, and multimodal inputs into model-ready data through composable operators and pipelines for refinement, generation, evaluation, and filtering.",
    highlights: ["Core contributor: advance the engineering of high-quality data generation and evaluation operators and reusable pipelines.", "Deployed in real-world projects with KuPas and the Suzhou Laboratory, among other partners."],
    linkLabels: ["GitHub repository", "Documentation", "Visual tutorials", "Video tutorials"],
  },
  dataflex: {
    title: "DataFlex",
    subtitle: "Data-centric dynamic training for LLMs",
    summary: "DataFlex provides a unified framework for data selection, mixture, and reweighting, enabling training data policies to adapt to model behavior and training progress.",
    highlights: ["Selection module lead: own the dynamic sample selection algorithm, training interfaces, and production integration.", "Integrated into the new official data processing module of LLaMA-Factory and deployed at China Unicom."],
    linkLabels: ["GitHub repository", "Documentation", "LLaMA-Factory"],
  },
  datamind: {
    title: "DataMind",
    subtitle: "All-in-one intelligent data assistant",
    summary: "An intelligent assistant built around LlamaIndex that brings RAG, GraphRAG, NL2SQL, Skills, Memory, and multimodal data access into one open-source system.",
    highlights: ["Project lead: drive product direction, technical roadmap, team collaboration, and delivery.", "Jointly developed with the Beijing Tongming Lake Information City Development Center."],
    linkLabels: ["GitHub repository", "Documentation"],
  },
};

const socialLinks = siteConfig.socialLinks.map((link) => ({
  ...link,
  label:
    link.label === "小红书"
      ? isEnglish ? "RedNote" : "小红书"
      : link.label === "邮件联系"
        ? "qiangmeiyi@gmail.com"
        : copy.socialLabels[link.label] ?? link.label,
  meta:
    link.label === "Google Scholar"
      ? isEnglish ? `${publicMetrics.scholar.citations.toLocaleString("en-US")} citations · h-index ${publicMetrics.scholar.hIndex}` : `引用 ${publicMetrics.scholar.citations.toLocaleString("zh-CN")} · h 指数 ${publicMetrics.scholar.hIndex}`
      : link.label === "小红书"
        ? isEnglish ? `${publicMetrics.xiaohongshu.followers.toLocaleString("en-US")} followers` : `${publicMetrics.xiaohongshu.followers.toLocaleString("zh-CN")} 粉丝`
        : undefined,
}));

const githubStars: Record<string, number> = publicMetrics.github;

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .filter((project) => project.id !== "originhub")
  .sort(
  (a, b) => a.data.order - b.data.order,
);

const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;
---

<Layout
  title={copy.pageTitle}
  description={copy.description}
  schemaType="ProfilePage"
  language={locale}
>
  <div class="profile-content space-y-14 pb-4 sm:space-y-20">
    <section id="about" class="home-section-card profile-hero-card scroll-mt-24 p-6 sm:p-8">
      <div>
        <div class="min-w-0">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-accent-700 dark:text-accent-300">{copy.aboutLabel}</p>
          <h1 class="section-heading mt-2 text-3xl sm:text-4xl">{copy.aboutHeading}</h1>

          <p class="mt-6 max-w-[62ch] text-[1.08rem] leading-8 text-ink-700 dark:text-paper-300">
            {copy.description}
          </p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={isEnglish ? "/en/researches" : "/researches"}
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-cyan-600 bg-gradient-to-r from-cyan-600 to-emerald-600 px-4 py-2.5 text-sm font-bold text-white no-underline shadow-[0_10px_24px_-14px_rgba(8,145,178,0.85)] transition hover:-translate-y-0.5 hover:from-cyan-700 hover:to-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 dark:border-cyan-500"
            >
              <span class="i-mdi:file-document-outline text-base" aria-hidden="true"></span>
              {copy.paperCta}
              <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
            </a>
          </div>

          <div class="contact-card mt-8 rounded-3xl border border-teal-300/75 bg-white/95 p-5 shadow-[0_14px_34px_-24px_rgba(13,148,136,0.45)] dark:border-teal-800/70 dark:bg-ink-900/95 sm:p-6">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">{copy.connectLabel}</p>
            <h2 class="mt-2 font-heading text-xl font-semibold text-ink-950 dark:text-paper-50">{copy.connectHeading}</h2>
            <p class="mt-2 max-w-[58ch] text-sm leading-7 text-ink-700 dark:text-paper-300">{copy.connectText}</p>
            <div class="mt-4 grid gap-2 sm:grid-cols-2">
              <div class="flex items-center gap-2 rounded-xl border border-paper-300/80 bg-white/65 px-3 py-2.5 dark:border-ink-700 dark:bg-ink-900/50">
                <span class="i-mdi:wechat text-lg text-accent-700 dark:text-accent-300" aria-hidden="true"></span>
                <span class="text-xs font-medium text-ink-500 dark:text-paper-400">{copy.wechatLabel}</span>
                <span class="ml-auto text-sm font-semibold text-ink-900 dark:text-paper-100">18991348420</span>
              </div>
              <a href="mailto:qiangmeiyi@gmail.com" class="group flex min-w-0 items-center gap-2 rounded-xl border border-paper-300/80 bg-white/65 px-3 py-2.5 transition-colors hover:border-accent-400 hover:bg-white dark:border-ink-700 dark:bg-ink-900/50 dark:hover:border-accent-700 dark:hover:bg-ink-900">
                <span class="i-mdi:email-outline text-lg text-accent-700 dark:text-accent-300" aria-hidden="true"></span>
                <span class="text-xs font-medium text-ink-500 dark:text-paper-400">{copy.emailLabel}</span>
                <span class="ml-auto min-w-0 break-all text-right text-sm font-semibold text-ink-900 group-hover:text-accent-800 dark:text-paper-100 dark:group-hover:text-accent-200">qiangmeiyi@gmail.com</span>
              </a>
            </div>
          </div>
        </div>

        <aside class="profile-sidebar mt-8" aria-label={isEnglish ? "Profile" : "个人简介"}>
          <div class="surface-card p-3.5">
            <div class="flex items-start gap-4 lg:block">
              <div class="w-28 shrink-0 overflow-hidden rounded-xl border border-paper-300/90 bg-white/70 p-1.5 shadow-paper dark:border-ink-700 dark:bg-ink-900/70 lg:mx-auto lg:w-40 lg:p-1.5">
                <Image
                  src={profileImageUrl}
                  alt={isEnglish ? "Portrait of Meiyi Qiang" : (siteConfig.hero.profileAlt || siteConfig.author)}
                  width={siteConfig.hero.profileImageWidth || 188}
                  height={siteConfig.hero.profileImageHeight || 252}
                  layout="constrained"
                  fit="cover"
                  priority
                  class="aspect-square h-auto w-full rounded-lg object-cover"
                />
              </div>
              <div class="min-w-0 lg:mt-3">
                <p class="font-heading text-2xl font-semibold text-ink-950 dark:text-paper-50">{copy.profileName}</p>
                <p class="mt-0.5 font-heading text-sm font-medium text-ink-600 dark:text-paper-300">{copy.profileEnglishName}</p>
              </div>
            </div>

            <div class="mt-3 border-t border-paper-300/80 pt-3 dark:border-ink-700/80">
              <div class="space-y-2">
                {sidebarEducation.map((item) => (
                  <div>
                    <p class="text-sm font-semibold text-ink-900 dark:text-paper-100">{item.institution}</p>
                    <p class="mt-0.5 text-[11px] leading-4 text-ink-600 dark:text-paper-300">{item.degree}</p>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-3 grid justify-items-start gap-1.5">
              {copy.profileTags.map((tag) => (
                <span class="rounded-full border border-accent-300/55 bg-accent-50/75 px-2.5 py-1 text-[13px] font-semibold leading-5 text-accent-800 dark:border-accent-700/60 dark:bg-accent-950/45 dark:text-accent-200">{tag}</span>
              ))}
            </div>

