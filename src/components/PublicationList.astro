---
import {
  citationStyleLabels,
  formatCitations,
  type BibEntry,
  type CitationStyle,
} from "../lib/bibtex";

interface Props {
  papers: BibEntry[];
  locale?: "zh" | "en";
}

const { papers, locale = "zh" } = Astro.props;
const isEnglish = locale === "en";
const citationStyles = Object.entries(citationStyleLabels) as [CitationStyle, string][];
const dialogId = `citation-dialog-${papers[0]?.id ?? "empty"}`;

function getDisplayAuthors(authors: string[]): string[] {
  if (authors.length <= 9) return authors;
  const visible = authors.slice(0, 4);
  if (!visible.includes("Meiyi Qiang")) visible.push("Meiyi Qiang");
  return [...visible, "et al."];
}

function highlightKind(label: string): string {
  if (label.toLowerCase() === "co-first author") return "cofirst";
  if (label.toLowerCase() === "core contributor") return "contributor";
  if (label.startsWith("Hugging Face")) return "hf";
  if (label.toLowerCase() === "oral") return "oral";
  if (label.toLowerCase() === "survey") return "survey";
  return "default";
}

function displayHighlight(label: string): string {
  if (isEnglish) return label;
  if (label.toLowerCase() === "co-first author") return "共同一作";
  if (label.toLowerCase() === "core contributor") return "核心贡献者";
  return label;
}
---

<div data-publication-citations data-locale={locale}>
  <ol
    data-publication-list
    class="m-0 grid list-none gap-5 p-0"
  >
    {papers.map((paper, index) => {
      const has摘要 = Boolean(paper.abstract);
      const citations = formatCitations(paper);
      const displayAuthors = getDisplayAuthors(paper.authors);
      const isTechnicalReport = paper.venue?.toLowerCase().includes("technical report");

      return (
        <li class="publication-card">
          <article class="group p-5 pl-6 sm:p-6 sm:pl-7">
            <div class="min-w-0 space-y-3">
              <div class="flex flex-wrap items-center gap-2" aria-label={isEnglish ? "Publication details" : "论文信息"}>
                {paper.venue && (
                  <span class:list={["publication-badge publication-badge--venue", isTechnicalReport && "publication-badge--report"]}>
                    <span class:list={[isTechnicalReport ? "i-mdi:file-document-edit-outline" : "i-mdi:school-outline", "text-sm"]} aria-hidden="true"></span>
                    {paper.venue}
                  </span>
                )}
                {paper.highlights.map((highlight) => (
                  <span class={`publication-badge publication-badge--${highlightKind(highlight)}`}>
                    {highlightKind(highlight) === "cofirst" && <span class="i-mdi:account-star-outline text-sm" aria-hidden="true"></span>}
                    {highlightKind(highlight) === "contributor" && <span class="i-mdi:account-group-outline text-sm" aria-hidden="true"></span>}
                    {highlightKind(highlight) === "hf" && <span class="i-ph:trophy-fill text-sm" aria-hidden="true"></span>}
                    {highlightKind(highlight) === "oral" && <span class="i-mdi:microphone-outline text-sm" aria-hidden="true"></span>}
                    {highlightKind(highlight) === "survey" && <span class="i-mdi:book-open-page-variant-outline text-sm" aria-hidden="true"></span>}
                    {displayHighlight(highlight)}
                  </span>
                ))}
                <span class="ml-auto font-mono text-[11px] font-semibold tabular-nums text-ink-400 dark:text-paper-500">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>

              <div class="space-y-1.5">
                <h3 class="entry-title text-[1.22rem] sm:text-[1.3rem]">
                  {paper.url ? (
                    <a
                      href={paper.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline text-inherit no-underline transition-colors hover:text-accent-700 focus-visible:text-accent-700 dark:hover:text-accent-300 dark:focus-visible:text-accent-300"
                    >
                      <span>{paper.title}</span>
                      <span
                        class="i-mdi:open-in-new ml-1 inline-block align-[0.05em] text-xs text-accent-600 dark:text-accent-300"
                        aria-hidden="true"
                      ></span>
                      <span class="sr-only">{isEnglish ? " opens in a new tab" : " 将在新标签页打开"}</span>
                    </a>
                  ) : paper.title}
                </h3>

                {displayAuthors.length > 0 && (
                  <p class="entry-supporting text-sm leading-6">
                    {displayAuthors.map((author, authorIndex) => (
                      <>
                        {authorIndex > 0 && ", "}
                        <span class:list={[author === "Meiyi Qiang" && "font-bold text-ink-900 dark:text-paper-100"]}>
                          {author}
                        </span>
                      </>
                    ))}
                  </p>
                )}
              </div>

              {paper.keywords.length > 0 && (
                <ul class="m-0 flex list-none flex-wrap gap-x-3 gap-y-1 p-0" aria-label={isEnglish ? "Topics" : "研究主题"}>
                  {paper.keywords.slice(0, 3).map((keyword) => (
                    <li class="font-mono text-[11px] text-ink-500 before:mr-1 before:text-accent-500 before:content-['#'] dark:text-paper-400">{keyword}</li>
                  ))}
                </ul>
              )}

              <div class="flex flex-wrap items-center gap-2 border-t border-paper-200/80 pt-3 dark:border-ink-700/70">
                {paper.url && (
                  <a
                    href={paper.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="publication-control action-link glass-control min-h-9 px-2.5 text-xs font-semibold leading-none"
                  >
                    <span class="i-mdi:file-document-outline !text-sm" aria-hidden="true"></span>
                    <span>{isEnglish ? "Paper" : "论文"}</span>
                    <span class="sr-only"> for {paper.title}, {isEnglish ? "opens in a new tab" : "将在新标签页打开"}</span>
                  </a>
                )}

                {paper.github && (
                  <a
                    href={paper.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="publication-control resource-link resource-link--github"
                    aria-label={`${paper.title} GitHub${paper.githubStars !== undefined ? `, ${paper.githubStars.toLocaleString("en-US")} stars` : ""}`}
                  >
                    <span class="i-mdi:github text-base" aria-hidden="true"></span>
                    <span>GitHub</span>
                    {paper.githubStars !== undefined && (
                      <span class="resource-count">★ {paper.githubStars.toLocaleString("en-US")}</span>
                    )}
                  </a>
                )}

                {paper.huggingFace && (
                  <a
                    href={paper.huggingFace}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="publication-control resource-link resource-link--hf"
                    aria-label={`${paper.title} Hugging Face`}
                  >
                    <span aria-hidden="true">🤗</span>
                    <span>Hugging Face</span>
                  </a>
                )}

                {paper.project && (
                  <a
                    href={paper.project}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="publication-control resource-link resource-link--project"
                    aria-label={isEnglish ? `${paper.title} project website` : `${paper.title} 项目主页`}
                  >
                    <span class="i-mdi:web text-base" aria-hidden="true"></span>
                    <span>{isEnglish ? "Project" : "项目主页"}</span>
                  </a>
                )}

                {has摘要 && (
                  <details class="group">
                    <summary class="publication-control action-link glass-control min-h-9 cursor-pointer list-none px-2.5 text-xs font-semibold leading-none">
                      <span
                        class="i-mdi:chevron-down !text-sm transition-transform duration-200 group-open:rotate-180"
                        aria-hidden="true"
                      ></span>
                      {isEnglish ? "Abstract" : "摘要"}
                    </summary>
                    <div class="body-copy mt-3 border-l-2 border-accent-300/80 py-1 pl-4 text-sm leading-relaxed dark:border-accent-700/80">
                      <p>{paper.abstract}</p>
                    </div>
                  </details>
                )}

                <button
                  type="button"
                  class="publication-control action-link glass-control min-h-9 cursor-pointer px-2.5 text-xs font-semibold leading-none"
                  data-citation-trigger
                  data-citation-title={paper.title}
                  data-citations={JSON.stringify(citations)}
                  aria-label={isEnglish ? `Cite ${paper.title}` : `引用 ${paper.title}`}
                  aria-haspopup="dialog"
                  aria-controls={dialogId}
                  title={isEnglish ? "View citation formats" : "查看引用格式"}
                >
                  <span class="i-mdi:content-copy !text-sm" aria-hidden="true"></span>
                  <span>{isEnglish ? "Cite" : "引用"}</span>
                </button>
              </div>
            </div>
          </article>
        </li>
      );
    })}
  </ol>

  <dialog
    id={dialogId}
    aria-labelledby={`${dialogId}-title`}
    data-citation-dialog
    data-current-style="bibtex"
    class="citation-dialog m-auto w-[min(42rem,calc(100%-2rem))] border-0 bg-transparent p-0 text-ink-900 dark:text-paper-100"
  >
    <div class="glass-popover max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-xl border border-paper-300/90 p-5 dark:border-ink-700 sm:p-6">
      <header class="flex items-start justify-between gap-5">
        <div class="min-w-0">
          <h3 id={`${dialogId}-title`} class="section-heading text-[1.5rem]">{isEnglish ? "Cite this paper" : "引用这篇论文"}</h3>
          <p data-citation-paper-title class="mt-1.5 line-clamp-2 text-sm leading-6 text-ink-600 dark:text-paper-300"></p>
        </div>
        <form method="dialog" class="shrink-0">
          <button type="submit" class="icon-button" aria-label={isEnglish ? "Close citation dialog" : "关闭引用窗口"}>
            <span class="i-ph-x-bold text-base" aria-hidden="true"></span>
          </button>
        </form>
      </header>

      <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label={isEnglish ? "Citation format" : "引用格式"}>
        {citationStyles.map(([style, label]) => (
          <button
            type="button"
            class:list={[
              "citation-style-btn glass-control min-h-10 cursor-pointer px-3 py-2 font-sans text-xs font-semibold text-ink-700 dark:text-paper-200",
              style === "bibtex" && "glass-active",
            ]}
            data-citation-style={style}
            aria-pressed={style === "bibtex" ? "true" : "false"}
          >
            {label}
          </button>
        ))}
      </div>

      <section class="mt-4 overflow-hidden rounded-lg border border-paper-300/90 bg-paper-100/70 dark:border-ink-700 dark:bg-ink-950/55" aria-labelledby={`${dialogId}-format`}>
        <div class="flex items-center justify-between gap-3 border-b border-paper-300/80 px-4 py-2.5 dark:border-ink-700">
          <h4 id={`${dialogId}-format`} data-citation-format-label class="font-sans text-xs font-semibold text-ink-700 dark:text-paper-200">{isEnglish ? "BibTeX citation" : "BibTeX 引用"}</h4>
          <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-ink-500 dark:text-paper-400">{isEnglish ? "Preview" : "预览"}</span>
        </div>
        <pre tabindex="-1" class="m-0 max-h-72 overflow-auto whitespace-pre-wrap break-words p-4 font-mono text-[0.8125rem] leading-6 text-ink-800 dark:text-paper-200"><code data-citation-output></code></pre>
      </section>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p data-copy-status aria-live="polite" class="min-h-5 text-xs text-ink-500 dark:text-paper-400">{isEnglish ? "Ready to copy." : "可复制引用。"}</p>
        <button type="button" data-copy-citation class="glass-control glass-active inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 px-4 text-sm font-semibold text-accent-900 dark:text-accent-100">
          <span data-copy-icon class="i-mdi:content-copy text-base" aria-hidden="true"></span>
          <span data-copy-label>{isEnglish ? "Copy citation" : "复制引用"}</span>
        </button>
      </div>
    </div>
  </dialog>
</div>

<style>
  .publication-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(218 216 207 / 0.88);
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 0.78);
    box-shadow: 0 10px 28px rgb(36 40 38 / 0.055);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .publication-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: linear-gradient(180deg, #63b7cd 0%, #78c3b2 52%, #e4ba64 100%);
    content: "";
  }

  .publication-card:hover {
    transform: translateY(-2px);
    border-color: rgb(105 169 183 / 0.72);
    box-shadow: 0 15px 36px rgb(36 40 38 / 0.09);
  }

  .publication-badge {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid rgb(211 216 216 / 0.95);
    border-radius: 999px;
    background: rgb(244 246 245 / 0.92);
    padding: 0.28rem 0.65rem;
    color: #495653;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
  }

  .publication-badge--venue {
    border-color: rgb(104 183 202 / 0.58);
    background: rgb(232 247 250 / 0.86);
    color: #276a7a;
  }

  .publication-badge--report {
    border-color: rgb(159 169 168 / 0.55);
    background: rgb(239 242 241 / 0.9);
    color: #4d5c59;
  }

  .publication-badge--hf {
    border-color: rgb(224 182 79 / 0.5);
    background: rgb(255 247 219 / 0.9);
    color: #815f0b;
  }

  .publication-badge--oral {
    border-color: rgb(224 155 91 / 0.5);
    background: rgb(255 239 223 / 0.9);
    color: #8a4a12;
  }

  .publication-badge--survey {
    border-color: rgb(153 137 202 / 0.45);
    background: rgb(242 238 253 / 0.9);
    color: #5d4d91;
  }

  .publication-badge--cofirst {
    border-color: rgb(176 122 193 / 0.48);
    background: rgb(249 239 251 / 0.92);
    color: #70427d;
  }

  .publication-badge--contributor {
    border-color: rgb(80 160 128 / 0.48);
    background: rgb(232 248 241 / 0.92);
    color: #276b54;
  }

  :global(.dark) .publication-card {
    border-color: rgb(66 74 71 / 0.88);
    background: rgb(31 36 34 / 0.82);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.18);
  }

  :global(.dark) .publication-card:hover {
    border-color: rgb(88 154 169 / 0.78);
  }

  :global(.dark) .publication-badge {
    border-color: rgb(82 93 90 / 0.9);
    background: rgb(45 52 49 / 0.9);
    color: #d5ddda;
  }

  :global(.dark) .publication-badge--venue {
    border-color: rgb(71 151 170 / 0.65);
    background: rgb(24 66 76 / 0.75);
    color: #a8dfea;
  }

  :global(.dark) .publication-badge--hf {
    border-color: rgb(174 136 49 / 0.62);
    background: rgb(75 59 18 / 0.75);
    color: #f4d47f;
  }

  :global(.dark) .publication-badge--oral {
    border-color: rgb(168 103 51 / 0.65);
    background: rgb(75 43 21 / 0.78);
    color: #f3bd88;
  }

  :global(.dark) .publication-badge--survey {
    border-color: rgb(126 105 181 / 0.62);
    background: rgb(53 42 85 / 0.75);
    color: #cec1f1;
  }

  :global(.dark) .publication-badge--cofirst {
    border-color: rgb(155 100 173 / 0.65);
    background: rgb(72 39 82 / 0.76);
    color: #e2b9ec;
  }

  :global(.dark) .publication-badge--contributor {
    border-color: rgb(68 139 111 / 0.68);
    background: rgb(28 68 53 / 0.78);
    color: #a9dfca;
  }

  .resource-link {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.4rem;
    border-radius: 0.625rem;
    padding: 0.45rem 0.7rem;
    color: #3f514d;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .resource-link:hover {
    border-color: rgb(83 145 158 / 0.7);
    background: rgb(237 247 247 / 0.95);
    color: #225d69;
  }

  .resource-link--hf {
    border-color: rgb(224 182 79 / 0.5);
    background: rgb(255 249 230 / 0.72);
    color: #74580e;
  }

  .resource-link--project {
    border-color: rgb(112 181 164 / 0.48);
    background: rgb(237 249 245 / 0.72);
    color: #326c60;
  }

  .resource-count {
    border-left: 1px solid currentColor;
    margin-left: 0.1rem;
    padding-left: 0.45rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    opacity: 0.82;
  }

  :global(.dark) .resource-link {
    color: #d2dcda;
  }

  :global(.dark) .resource-link:hover {
    border-color: rgb(86 153 167 / 0.75);
    background: rgb(28 65 72 / 0.7);
    color: #b7e4ec;
  }

  :global(.dark) .resource-link--hf {
    border-color: rgb(174 136 49 / 0.6);
    background: rgb(70 55 18 / 0.66);
    color: #f0d17d;
  }

  :global(.dark) .resource-link--project {
    border-color: rgb(75 139 124 / 0.62);
    background: rgb(24 61 52 / 0.68);
    color: #aae0d3;
  }

  .publication-control {
    appearance: none;
    border: 1px solid var(--glass-control-border);
    background: var(--glass-control);
  }

  .citation-dialog::backdrop {
    background: rgb(22 25 24 / 0.58);
  }
</style>

<script>
  const labels = {
    bibtex: "BibTeX",
    apa: "APA 7",
    chicago: "Chicago",
    harvard: "Harvard",
  } as const;

  async function copyText(value: string) {
    await navigator.clipboard.writeText(value);
  }

  function setupCitationDialogs() {
    document.querySelectorAll<HTMLElement>("[data-publication-citations]").forEach((container) => {
      if (container.dataset.citationBound) return;
      container.dataset.citationBound = "true";
      const isEnglish = container.dataset.locale === "en";

      const dialog = container.querySelector<HTMLDialogElement>("[data-citation-dialog]");
      const title = dialog?.querySelector<HTMLElement>("[data-citation-paper-title]");
      const output = dialog?.querySelector<HTMLElement>("[data-citation-output]");
      const formatLabel = dialog?.querySelector<HTMLElement>("[data-citation-format-label]");
      const status = dialog?.querySelector<HTMLElement>("[data-copy-status]");
      const copyButton = dialog?.querySelector<HTMLButtonElement>("[data-copy-citation]");
      const copyIcon = dialog?.querySelector<HTMLElement>("[data-copy-icon]");
      const copyLabel = dialog?.querySelector<HTMLElement>("[data-copy-label]");
      const styleButtons = dialog?.querySelectorAll<HTMLButtonElement>("[data-citation-style]");
      if (!dialog || !title || !output || !formatLabel || !status || !copyButton || !copyIcon || !copyLabel || !styleButtons) return;

      let citations: Record<string, string> = {};
      let currentStyle: keyof typeof labels = "bibtex";
      let lastTrigger: HTMLButtonElement | null = null;
      let resetTimer = 0;

      const resetCopyState = () => {
        window.clearTimeout(resetTimer);
        copyIcon.className = "i-mdi:content-copy text-base";
        copyLabel.textContent = isEnglish ? "Copy citation" : "复制引用";
        status.textContent = isEnglish ? "Ready to copy." : "可复制引用。";
      };

      const selectStyle = (style: keyof typeof labels) => {
        currentStyle = style;
        dialog.dataset.currentStyle = style;
        output.textContent = citations[style] ?? "";
        output.parentElement?.classList.toggle("font-mono", style === "bibtex");
        output.parentElement?.classList.toggle("font-sans", style !== "bibtex");
        formatLabel.textContent = isEnglish
          ? `${labels[style]} citation`
          : `${labels[style]} 引用`;
        styleButtons.forEach((button) => {
          const selected = button.dataset.citationStyle === style;
          button.setAttribute("aria-pressed", String(selected));
          button.classList.toggle("glass-active", selected);
        });
        resetCopyState();
      };

      container.querySelectorAll<HTMLButtonElement>("[data-citation-trigger]").forEach((button) => {
        button.addEventListener("click", () => {
          try {
            citations = JSON.parse(button.dataset.citations ?? "{}");
          } catch {
            return;
          }
          lastTrigger = button;
          title.textContent = button.dataset.citationTitle ?? "";
          selectStyle("bibtex");
          dialog.showModal();
        });
      });

      styleButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const style = button.dataset.citationStyle as keyof typeof labels;
          if (style in labels) selectStyle(style);
        });
      });

      copyButton.addEventListener("click", async () => {
        if (!output.textContent) return;
        try {
          await copyText(output.textContent);
          copyIcon.className = "i-mdi:check text-base text-emerald-600 dark:text-emerald-400";
          copyLabel.textContent = isEnglish ? "Copied" : "已复制";
          status.textContent = isEnglish
            ? `${labels[currentStyle]} citation copied.`
            : `已复制 ${labels[currentStyle]} 引用。`;
          resetTimer = window.setTimeout(resetCopyState, 2000);
        } catch {
          status.textContent = isEnglish
            ? "Copy unavailable. Select the citation text manually."
            : "无法自动复制，请手动选择引用文本。";
          output.parentElement?.focus();
        }
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        resetCopyState();
        lastTrigger?.focus();
      });
    });
  }

  document.addEventListener("astro:page-load", setupCitationDialogs);
</script>
