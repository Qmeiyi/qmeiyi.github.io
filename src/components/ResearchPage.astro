---
import Layout from "../layouts/Layout.astro";
import FilterBar from "../components/FilterBar.astro";
import PublicationList from "../components/PublicationList.astro";
import { getAllPapers } from "../lib/papers";
import siteConfig from "../side.config";

interface Props {
  locale?: "zh" | "en";
}

const { locale = "zh" } = Astro.props;
const isEnglish = locale === "en";

const papers = getAllPapers();
const groupedByYear = new Map<number, typeof papers>();

for (const paper of papers) {
  const year = paper.year ?? 0;
  if (!groupedByYear.has(year)) groupedByYear.set(year, []);
  groupedByYear.get(year)?.push(paper);
}

const years = Array.from(groupedByYear.keys()).sort((a, b) => b - a);

// Count total papers
const totalPapers = papers.length;
const pageTitle = isEnglish
  ? "Publications"
  : (siteConfig.pageTitles.researches.title || "研究成果");
const pageDescription = isEnglish
  ? "Publications and preprints listed on Google Scholar, organized by year."
  : "Google Scholar 收录的论文、会议论文与预印本，按年份整理。";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schemaType="CollectionPage"
  language={locale}
>
  <div class="page-stack">
    <header class="page-header">
      <h1 class="page-title">{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>
      <a
        href="https://scholar.google.com/citations?user=8g78CmwAAAAJ&hl=zh-CN"
        target="_blank"
        rel="noopener noreferrer"
        class="action-link mt-3 px-0"
      >
        <span class="i-academicons:google-scholar text-base" aria-hidden="true"></span>
        {isEnglish ? "Google Scholar profile" : "Google Scholar 主页"}
        <span class="i-mdi:open-in-new text-sm" aria-hidden="true"></span>
      </a>

	  <FilterBar
		total={totalPapers}
		allIcon="i-mdi:file-document-multiple"
		allLabel={isEnglish ? "All" : "全部"}
		ariaLabel={isEnglish ? "Filter publications" : "筛选论文"}
		items={years.map((year) => ({
		  filter: `year-${year}`,
		  label: String(year),
		  count: groupedByYear.get(year)?.length || 0,
		  icon: "i-mdi:calendar-blank-outline",
		}))}
	  />
    </header>

    <div class="space-y-6 sm:space-y-7" id="papers-container" data-publication-total={totalPapers}>
      {papers.length === 0 && <p data-empty-publications class="body-copy">{isEnglish ? "No publications yet." : "暂无论文。"}</p>}
      {
        years.map((year) => {
          const yearPapers = groupedByYear.get(year);
          if (!yearPapers?.length) {
            return null;
          }
          const yearSlug = `year-${year}`;

          return (
            <section
              id={yearSlug}
              class="content-section paper-section scroll-mt-20 space-y-4"
              data-filter-section={yearSlug}
            >
              <header class="flex items-end justify-between gap-4 border-b border-paper-300/90 pb-3 dark:border-ink-700">
				<h2 class="section-heading">{year}</h2>
				<p class="shrink-0 font-mono text-xs font-semibold tabular-nums text-ink-500 dark:text-paper-400">
                  {isEnglish ? `${yearPapers.length} ${yearPapers.length === 1 ? "paper" : "papers"}` : `${yearPapers.length} 篇`}
                </p>
              </header>

              <PublicationList papers={yearPapers} locale={locale} />
            </section>
          );
        })
      }
    </div>
  </div>
</Layout>

<script>
  import { setupFilterControls } from "../scripts/ui";

  document.addEventListener("astro:page-load", () => {
    setupFilterControls();
  });
</script>
