---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { parse } from "yaml";
import siteConfig from "../side.config";
import aboutRaw from "../data/about.yml?raw";
import newsRaw from "../data/news.yml?raw";

type NewsItem = {
  date: string | number;
  text: string;
  link?: { label: string; href: string };
};

type Experience = {
  role?: string;
  organization?: string;
  period?: string;
  bullets?: string[];
};

type Education = {
  degree?: string;
  institution?: string;
  year?: string;
};

type AboutSection = {
  title?: string;
  items?: Array<string | { title?: string; description?: string }>;
};

type AboutData = {
  experience?: Experience[];
  education?: Education[];
  sections?: AboutSection[];
};

const news = (parse(newsRaw) ?? []) as NewsItem[];
const about = (parse(aboutRaw) ?? {}) as AboutData;
const experience = about.experience ?? [];
const education = about.education ?? [];
const honors =
  about.sections
    ?.find((section) => section.title === "荣誉奖励")
    ?.items?.filter((item): item is string => typeof item === "string") ?? [];

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;
---

<Layout
  title="首页"
  description={siteConfig.hero.subheadline}
  schemaType="ProfilePage"
>
  <div class="space-y-14 pb-4 sm:space-y-20">
    <section class="border-b border-paper-300/90 pb-10 pt-3 dark:border-ink-700 sm:pb-14 sm:pt-6">
      <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-x-14">
        <div class="min-w-0">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-accent-700 dark:text-accent-300">
            Research · Open Source · Entrepreneurship
          </p>
          <h1 class="mt-3 max-w-4xl font-heading text-[clamp(2.7rem,6vw,4.7rem)] font-semibold leading-none tracking-[-0.04em] text-ink-950 dark:text-paper-50">
            {siteConfig.author}
          </h1>
          <p class="mt-3 font-heading text-xl font-medium text-ink-700 dark:text-paper-200 sm:text-2xl">
            Meiyi Qiang
          </p>

          <div class="mt-5 space-y-1">
            {siteConfig.affiliations.map((affiliation) => (
              <p class="text-base leading-7 text-ink-600 dark:text-paper-300">
                {affiliation.role}，
                {affiliation.url ? (
                  <a
                    href={affiliation.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 dark:text-accent-300 dark:decoration-accent-700"
                  >
                    {affiliation.institution}
                  </a>
                ) : (
                  affiliation.institution
                )}
              </p>
            ))}
          </div>

          <p class="mt-6 max-w-[68ch] text-[1.08rem] leading-8 text-ink-700 dark:text-paper-300">
            {siteConfig.hero.subheadline}
          </p>

          <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
            <a href="/researches" class="action-link px-0">
              <span class="i-mdi:file-document-outline text-base" aria-hidden="true"></span>
              研究成果与论文
              <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
            </a>
            {siteConfig.socialLinks.map((link) => (
              <a
                href={link.href}
                target={/^https?:/i.test(link.href) ? "_blank" : undefined}
                rel={/^https?:/i.test(link.href) ? "noopener noreferrer" : undefined}
                class="action-link px-0"
              >
                <span class={`${link.icon} text-base`} aria-hidden="true"></span>
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <aside class="flex items-start gap-4 lg:block">
          <div class="w-24 overflow-hidden rounded-xl border border-paper-300/90 bg-white/70 p-1.5 shadow-paper dark:border-ink-700 dark:bg-ink-900/70 lg:w-full lg:p-2">
            <Image
              src={profileImageUrl}
              alt={siteConfig.hero.profileAlt || siteConfig.author}
              width={siteConfig.hero.profileImageWidth || 188}
              height={siteConfig.hero.profileImageHeight || 252}
              layout="constrained"
              fit="cover"
              priority
              class="aspect-square h-auto w-full rounded-lg object-cover"
            />
          </div>
          <div class="mt-1 inline-flex items-center gap-1.5 rounded-md border border-accent-300/40 bg-accent-50/70 px-2.5 py-1 text-xs font-semibold text-accent-800 dark:border-accent-700/50 dark:bg-accent-950/40 dark:text-accent-200 lg:mt-4">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
            {siteConfig.hero.statusBadge}
          </div>
        </aside>
      </div>
    </section>

    <section class="content-section" aria-labelledby="news-heading">
      <div class="mb-5 border-b border-paper-300/90 pb-4 dark:border-ink-700">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">News</p>
        <h2 id="news-heading" class="section-heading mt-1">近期动态</h2>
      </div>
      <ol class="divide-y divide-paper-300/80 border-y border-paper-300/80 dark:divide-ink-700/80 dark:border-ink-700/80">
        {news.map((item) => (
          <li class="grid gap-2 py-4 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-5">
            <time class="font-mono text-sm font-semibold tabular-nums text-accent-700 dark:text-accent-300">{item.date}</time>
            <p class="text-[0.98rem] leading-7 text-ink-700 dark:text-paper-300">
              {item.text}
              {item.link && (
                <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="ml-2 font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 dark:text-accent-300 dark:decoration-accent-700">
                  {item.link.label}
                </a>
              )}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="content-section" aria-labelledby="research-heading">
      <div class="mb-6 border-b border-paper-300/90 pb-4 dark:border-ink-700">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">Research Interests</p>
        <h2 id="research-heading" class="section-heading mt-1">研究方向</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {siteConfig.researchInterests.map((interest, index) => (
          <article class="surface-card p-5 sm:p-6">
            <span class="font-mono text-xs font-semibold text-accent-700 dark:text-accent-300">0{index + 1}</span>
            <h3 class="entry-title mt-3 text-xl">{interest}</h3>
          </article>
        ))}
      </div>
      <a href="/researches" class="action-link mt-5 px-0">
        查看完整论文列表
        <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
      </a>
    </section>

    <section class="content-section" aria-labelledby="projects-heading">
      <div class="mb-6 border-b border-paper-300/90 pb-4 dark:border-ink-700">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">Selected Work</p>
        <h2 id="projects-heading" class="section-heading mt-1">项目与创业实践</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-600 dark:text-paper-300">从研究方法、开源系统到产业落地，持续推进以数据为中心的人工智能实践。</p>
      </div>
      <div class="grid gap-5 lg:grid-cols-3">
        {projects.map((project, index) => (
          <article class="surface-card flex h-full flex-col p-5 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-xs font-semibold text-accent-700 dark:text-accent-300">0{index + 1}</span>
              <span class={project.data.status === "active" ? "chip-status-active" : "chip-status-past"}>
                {project.data.status === "active" ? "进行中" : "已完成"}
              </span>
            </div>
            <h3 class="entry-title mt-4 text-xl">{project.data.title}</h3>
            {project.data.subtitle && <p class="mt-1 text-xs font-semibold text-accent-700 dark:text-accent-300">{project.data.subtitle}</p>}
            <p class="mt-3 text-sm leading-7 text-ink-700 dark:text-paper-300">{project.data.summary}</p>
            {project.data.highlights.length > 0 && (
              <ul class="mt-4 space-y-2 text-sm leading-6 text-ink-600 dark:text-paper-300">
                {project.data.highlights.map((highlight) => (
                  <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span><span>{highlight}</span></li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex flex-wrap gap-3 pt-5">
              {project.data.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="action-link px-0 text-xs">
                  {link.label}<span class="i-mdi:open-in-new text-sm" aria-hidden="true"></span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section" aria-labelledby="experience-heading">
      <div class="mb-6 border-b border-paper-300/90 pb-4 dark:border-ink-700">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">Experience</p>
        <h2 id="experience-heading" class="section-heading mt-1">科研与产业经历</h2>
      </div>
      <div class="relative ml-2 border-l-2 border-paper-300/90 pl-6 dark:border-ink-700 sm:pl-8">
        {experience.map((item) => (
          <article class="relative pb-8 last:pb-0">
            <span class="absolute -left-[1.95rem] top-1.5 h-3 w-3 rounded-full border-2 border-accent-600 bg-paper-50 dark:bg-ink-950 sm:-left-[2.45rem]"></span>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <div>
                <h3 class="entry-title text-lg">{item.role}</h3>
                <p class="mt-1 font-semibold text-accent-700 dark:text-accent-300">{item.organization}</p>
              </div>
              <time class="shrink-0 font-mono text-xs text-ink-500 dark:text-paper-400">{item.period}</time>
            </div>
            {item.bullets && (
              <ul class="mt-3 space-y-1.5 text-sm leading-7 text-ink-700 dark:text-paper-300">
                {item.bullets.map((bullet) => <li>• {bullet}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
      <section class="content-section" aria-labelledby="education-heading">
        <div class="mb-5 border-b border-paper-300/90 pb-4 dark:border-ink-700">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">Education</p>
          <h2 id="education-heading" class="section-heading mt-1">教育背景</h2>
        </div>
        <div class="space-y-4">
          {education.map((item) => (
            <article class="surface-card p-5">
              <h3 class="entry-title text-lg">{item.institution}</h3>
              <p class="mt-1 text-sm text-ink-700 dark:text-paper-300">{item.degree}</p>
              <time class="mt-2 block font-mono text-xs text-ink-500 dark:text-paper-400">{item.year}</time>
            </article>
          ))}
        </div>
      </section>

      <section class="content-section" aria-labelledby="honors-heading">
        <div class="mb-5 border-b border-paper-300/90 pb-4 dark:border-ink-700">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">Honors</p>
          <h2 id="honors-heading" class="section-heading mt-1">荣誉奖励</h2>
        </div>
        <ul class="space-y-4">
          {honors.map((honor, index) => (
            <li class="surface-card flex items-center gap-4 p-5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-50 font-mono text-xs font-semibold text-accent-700 dark:bg-accent-950/50 dark:text-accent-300">0{index + 1}</span>
              <span class="font-heading text-lg font-semibold text-ink-900 dark:text-paper-100">{honor}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="rounded-2xl border border-accent-300/50 bg-accent-50/60 p-6 dark:border-accent-800/70 dark:bg-accent-950/30 sm:p-8" aria-labelledby="contact-heading">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-accent-700 dark:text-accent-300">Let’s Connect</p>
      <h2 id="contact-heading" class="mt-2 font-heading text-3xl font-semibold tracking-[-0.02em] text-ink-950 dark:text-paper-50">交流与合作</h2>
      <p class="mt-3 max-w-2xl leading-7 text-ink-700 dark:text-paper-300">欢迎围绕数据中心人工智能、大模型训练数据、开源协作与产业应用交流。</p>
      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
        {siteConfig.socialLinks.map((link) => (
          <a href={link.href} target={/^https?:/i.test(link.href) ? "_blank" : undefined} rel={/^https?:/i.test(link.href) ? "noopener noreferrer" : undefined} class="action-link px-0">
            <span class={`${link.icon} text-base`} aria-hidden="true"></span>{link.label}
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
