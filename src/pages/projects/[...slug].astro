---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DetailShell from "../../components/DetailShell.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await render(project);
const { data } = project;
const status = data.status === "active" ? "进行中" : "已完成";
---

<Layout
  contentSource={project.filePath}
  title={data.title}
  description={data.summary}
  image={data.cover?.src}
  imageAlt={data.coverAlt}
  imageWidth={data.cover?.width}
  imageHeight={data.cover?.height}
>
  <DetailShell
    backHref="/projects"
    backLabel="全部项目"
    title={data.title}
    summary={data.summary}
    transitionKey={`project-${project.id}`}
    cover={data.cover}
    coverAlt={data.coverAlt}
    facts={[
      { label: "状态", value: status },
      { label: "时间", value: data.period },
      ...data.metadata,
    ]}
    tags={[...data.badges, ...data.tech]}
    highlights={data.highlights}
    resources={data.links}
  >
    <Content />
  </DetailShell>
</Layout>
